                                                <RadioButton x:Name="HndPanelPageHeader" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xEB9F;"
                                                             Content="{DynamicResource LOCHNDPanelPageHeader}" />

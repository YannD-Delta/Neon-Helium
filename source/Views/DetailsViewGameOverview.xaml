                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Margin" Value="20,10,0,10" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid x:Name="HeroActions" HorizontalAlignment="Left" MinWidth="200"
                                              Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonWidth], FallbackValue={StaticResource HeroActionButtonWidth}, TargetNullValue={StaticResource HeroActionButtonWidth}}"
                                              Style="{DynamicResource HeroFadeInStyle}" AutomationProperties.HelpText="{Binding Game.Id, NotifyOnTargetUpdated=True}">

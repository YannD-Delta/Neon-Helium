                                                    </Grid.Style>
                                                <StackPanel Name="ScreenshotsVisualizerPanel" Style="{DynamicResource PluginStackpanelVisibility}"
                                                            Visibility="{PluginSettings Plugin=ScreenshotsVisualizer, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewExpandScreenshotsVisualizerPanel], FallbackValue={StaticResource DetailsViewExpandScreenshotsVisualizerPanel}, TargetNullValue={StaticResource DetailsViewExpandScreenshotsVisualizerPanel}}">
                                                        <ToggleButton x:Name="DetailsViewScreenshotsVisualizerPanelToggleButton" MinHeight="{PluginSettings Plugin=ThemeOptions, Path=Options[SectionHeaderMinHeight], FallbackValue={StaticResource SectionHeaderMinHeight}, TargetNullValue={StaticResource SectionHeaderMinHeight}}"
                                                                      Margin="0,0,0,10" Focusable="False">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource DetailsSectionHeaderToggleButton}">
                                                                    <!-- WPF only accepts Binding or DynamicResource as a setter value: read the live option from the header Grid Tag -->
                                                                    <Setter Property="IsChecked" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}, Mode=OneWay}" />
                                                                    <Style.Triggers>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <Label Content="{DynamicResource LOCSsvTitle}"
                                                                   Style="{DynamicResource FeedSectionLabel}" Margin="0" />
                                                        </ToggleButton>
                                                        <!-- Quick settings: where and how this section shows, applied at once through Theme Options -->
                                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,32,0" Height="{PluginSettings Plugin=ThemeOptions, Path=Options[SectionHeaderMinHeight], FallbackValue={StaticResource SectionHeaderMinHeight}, TargetNullValue={StaticResource SectionHeaderMinHeight}}">
                                                            <ToggleButton x:Name="QuickSettingsScreenshotsVisualizerToggle" Style="{DynamicResource SectionQuickSettingsToggle}" VerticalAlignment="Center"
                                                                          IsChecked="{Binding IsChecked, ElementName=HndPanelPageSectionScreenshotsVisualizer, Mode=TwoWay}" />
                                                        </Grid>
                                                    </Grid>
                                                    <Grid Style="{DynamicResource AdditionalPanelContent}"
                                                          Tag="{Binding ElementName=DetailsViewScreenshotsVisualizerPanelToggleButton, Path=IsChecked}">
                                                        <Border Style="{DynamicResource OutlineBorderSidePanelsBorder}" />
                                                        <Border Style="{DynamicResource OutlineBorderSidePanels}" />
                                                        <Border Padding="10" >
                                                            <StackPanel>
                                                                <ContentControl x:Name="ScreenshotsVisualizer_PluginSinglePicture" Margin="0,0,0,10"/>
                                                                <ContentControl x:Name="ScreenshotsVisualizer_PluginListScreenshotsVertical" Margin="0,0,0,10" MinHeight="300"/>
                                                                <Button Name="PART_CustomSsvButton" HorizontalAlignment="Right">
                                                                    <ContentControl x:Name="ScreenshotsVisualizer_PluginViewItem" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                                </Grid>

                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Grid.Row" Value="{DynamicResource DetailsViewSectionOrderReviewViewer}" />
                                                            <Style.Triggers>
                                                                <!-- tabs mode: hidden unless this section belongs to the selected tab (the triggers below still hide it) -->
                                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewTabsMode], FallbackValue={StaticResource DetailsViewTabsMode}, TargetNullValue={StaticResource DetailsViewTabsMode}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsChecked, ElementName=DetailsTabAll}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewTabReviewViewer], FallbackValue={StaticResource DetailsViewTabReviewViewer}, TargetNullValue={StaticResource DetailsViewTabReviewViewer}}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsChecked, ElementName=DetailsTabAbout}" Value="True" />
                                                                        <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewTabReviewViewer], FallbackValue={StaticResource DetailsViewTabReviewViewer}, TargetNullValue={StaticResource DetailsViewTabReviewViewer}}" Value="1" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsChecked, ElementName=DetailsTabMedia}" Value="True" />
                                                                        <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewTabReviewViewer], FallbackValue={StaticResource DetailsViewTabReviewViewer}, TargetNullValue={StaticResource DetailsViewTabReviewViewer}}" Value="2" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsChecked, ElementName=DetailsTabStats}" Value="True" />
                                                                        <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewTabReviewViewer], FallbackValue={StaticResource DetailsViewTabReviewViewer}, TargetNullValue={StaticResource DetailsViewTabReviewViewer}}" Value="3" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsChecked, ElementName=DetailsTabCommunity}" Value="True" />
                                                                        <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewTabReviewViewer], FallbackValue={StaticResource DetailsViewTabReviewViewer}, TargetNullValue={StaticResource DetailsViewTabReviewViewer}}" Value="4" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowReviewsPanel], FallbackValue={StaticResource DetailsViewShowReviewsPanel}, TargetNullValue={StaticResource DetailsViewShowReviewsPanel}}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                <StackPanel Name="ReviewsPanel" Margin="0"
                                                            Visibility="{PluginSettings Plugin=ReviewViewer, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewExpandReviewsPanel], FallbackValue={StaticResource DetailsViewExpandReviewsPanel}, TargetNullValue={StaticResource DetailsViewExpandReviewsPanel}}">
                                                        <ToggleButton x:Name="DetailsViewReviewsPanelToggleButton" MinHeight="{PluginSettings Plugin=ThemeOptions, Path=Options[SectionHeaderMinHeight], FallbackValue={StaticResource SectionHeaderMinHeight}, TargetNullValue={StaticResource SectionHeaderMinHeight}}"
                                                                      Margin="0,0,0,10" Focusable="False">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource DetailsSectionHeaderToggleButton}">
                                                                    <!-- WPF only accepts Binding or DynamicResource as a setter value: read the live option from the header Grid Tag -->
                                                                    <Setter Property="IsChecked" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}, Mode=OneWay}" />
                                                                    <Style.Triggers>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <Label Content="{DynamicResource LOCReview_Viewer_ReviewsLabel}"
                                                                   Style="{DynamicResource FeedSectionLabel}" Margin="0" />
                                                        </ToggleButton>
                                                        <!-- Quick settings: where and how this section shows, applied at once through Theme Options -->
                                                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,32,0" Height="{PluginSettings Plugin=ThemeOptions, Path=Options[SectionHeaderMinHeight], FallbackValue={StaticResource SectionHeaderMinHeight}, TargetNullValue={StaticResource SectionHeaderMinHeight}}">
                                                            <ToggleButton x:Name="QuickSettingsReviewsToggle" Style="{DynamicResource SectionQuickSettingsToggle}" VerticalAlignment="Center"
                                                                          IsChecked="{Binding IsChecked, ElementName=HndPanelPageSectionReviews, Mode=TwoWay}" />
                                                        </Grid>
                                                    </Grid>
                                                    <Grid Style="{DynamicResource AdditionalPanelContent}"
                                                          Tag="{Binding ElementName=DetailsViewReviewsPanelToggleButton, Path=IsChecked}">
                                                        <Border Style="{DynamicResource OutlineBorderSidePanelsBorder}" />
                                                        <Border Style="{DynamicResource OutlineBorderSidePanels}" />
                                                        <Border Padding="10">
                                                            <ContentControl x:Name="ReviewViewer_ReviewsControl" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                                </Grid>
                                                
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>


                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="#25272d" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="6,6,6,6" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Stretch="Uniform" Width="20" Height="20"
                                     VerticalAlignment="Center">
                                <Canvas Width="36" Height="36">
                                    <Path Fill="{TemplateBinding Foreground}"
                                          Data="M34 7V11H2V7H34ZM6 20H30V16H6V20ZM10 29H26V25H10V29Z"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Margin="3,0,0,0" VerticalAlignment="Center"
                                       Name="TextFilter" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                            <Setter Property="Foreground" Value="#ccffffff" />
                            <Setter Property="Background" Value="#1e90ff" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TopPanelItemIsMouseOverForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="6,6,6,6" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="#25272d" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Border" CornerRadius="2"
                            VerticalAlignment="Center"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Stretch="Uniform" Width="20" Height="20"
                                     VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Canvas Width="36" Height="36">
                                    <Path Fill="{TemplateBinding Foreground}"
                                          Data="M32 24V26H4V24L8 19V12C8 9.34784 9.05357 6.8043 10.9289 4.92893C12.8043 3.05357 15.3478 2 18 2C20.6522 2 23.1957 3.05357 25.0711 4.92893C26.9464 6.8043 28 9.34784 28 12V19L32 24Z"/>
                                    <Path Fill="{TemplateBinding Foreground}"
                                          Data="M18 34C19.2396 33.9986 20.4483 33.6133 21.46 32.897C22.4718 32.1807 23.2368 31.1687 23.65 30H12.35C12.7632 31.1687 13.5282 32.1807 14.54 32.897C15.5517 33.6133 16.7604 33.9986 18 34Z"/>
                                </Canvas>
                            </Viewbox>
                            <Border CornerRadius="3" MinWidth="15" Height="15"
                                    Margin="3,0,0,0" Background="OrangeRed" Padding="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3e4047" />
                <Setter Property="Foreground" Value="#ccffffff" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelHeight], FallbackValue={StaticResource TopPanelHeight}, TargetNullValue={StaticResource TopPanelHeight}}" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{TemplateBinding Background}"
                            d:DesignWidth="1280"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                                        <Setter Property="BorderThickness" Value="0,1,0,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Margin="0,3,110,3">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                    DockPanel.Dock="Left" Margin="5,0,0,0" Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Image Source="{ThemeFile 'Images/applogo.png'}"
                                       Height="40" RenderOptions.BitmapScalingMode="Fant"
                                       Margin="10,0,10,0"/>
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch"
                                       Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}"
                                       Margin="0,6,0,6" DockPanel.Dock="Left"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       Width="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelSearchBoxWidthHelium], FallbackValue={StaticResource TopPanelSearchBoxWidthHelium}, TargetNullValue={StaticResource TopPanelSearchBoxWidthHelium}}"
                                       MaxWidth="{Settings DetailsListWitdh}" />

                            <Border Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowNavigationButtons], FallbackValue={StaticResource ShowNavigationButtons}, TargetNullValue={StaticResource ShowNavigationButtons}}"
                                    DockPanel.Dock="Left"
                                    Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}"
                                            Margin="{Binding ElementName=PART_ToggleNotifications, Path=Margin}"
                                            Orientation="Horizontal">
                                    <Button Style="{DynamicResource TopPanelNavigateBackButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.BackCommand, FallbackValue={x:Null}}" />
                                    <Button Style="{DynamicResource TopPanelNavigateForwardButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.ForwardCommand, FallbackValue={x:Null}}" />
                                </StackPanel>
                            </Border>
                            
                            <!-- Theme workshop: live settings popup (always available) -->
                            <!-- BEGIN generated workshop: edit tools/options_spec.yaml (workshop), then run tools/build_options.py -->
                            <Grid VerticalAlignment="Center" Margin="{Binding ElementName=PART_ToggleNotifications, Path=Margin}">
                                <ToggleButton x:Name="ThemeWorkshopToggle" Style="{DynamicResource TopPanelWorkshopToggleStyle}"
                                              ToolTip="{DynamicResource LOCHNDWorkshopTooltip}" />
                                <Popup IsOpen="{Binding IsChecked, ElementName=ThemeWorkshopToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                                       PlacementTarget="{Binding ElementName=ThemeWorkshopToggle}" Placement="Bottom" VerticalOffset="6">
                                    <Grid Width="{PluginSettings Plugin=ThemeOptions, Path=Options[SettingsPanelWidth], FallbackValue={StaticResource SettingsPanelWidth}, TargetNullValue={StaticResource SettingsPanelWidth}}" Height="{PluginSettings Plugin=ThemeOptions, Path=Options[SettingsPanelHeight], FallbackValue={StaticResource SettingsPanelHeight}, TargetNullValue={StaticResource SettingsPanelHeight}}">
                                    <!-- look (Theme Options list "Settings panel"): profile popup colors under an optional dark or glass overlay -->
                                    <Border Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="{DynamicResource SettingsPanelCornerRadius}"
                                            Opacity="{DynamicResource SettingsPanelProfileOpacity}" />
                                    <Border Style="{DynamicResource HndPanelFrame}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                                <ToggleButton DockPanel.Dock="Right" Style="{DynamicResource HndPanelClose}" ToolTip="{DynamicResource LOCHNDPanelClose}"
                                                              IsChecked="{Binding IsChecked, ElementName=ThemeWorkshopToggle, Mode=TwoWay}" />
                                                <TextBlock Style="{DynamicResource HndPanelTitle}" Text="{DynamicResource LOCHNDWorkshopTitle}" />
                                                <TextBlock Style="{DynamicResource HndPanelHint}" Text="{DynamicResource LOCHNDQuickNeedsThemeOptions}"
                                                           Visibility="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                                            </DockPanel>
                                            <ScrollViewer DockPanel.Dock="Left" Width="230" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                                                <StackPanel>
                                                    <RadioButton x:Name="HndTopPageChips" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}" IsChecked="True" Tag="&#xE8FD;"
                                                                 Content="{DynamicResource LOCHNDPanelPageChips}" />
                                                    <RadioButton x:Name="HndTopPageHeader" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xEB9F;"
                                                                 Content="{DynamicResource LOCHNDPanelPageHeader}" />
                                                    <RadioButton x:Name="HndTopPageHeaderBar" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xE8A1;"
                                                                 Content="{DynamicResource LOCHNDPanelPageHeaderBar}" />
                                                    <RadioButton x:Name="HndTopPageCovers" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xE8B9;"
                                                                 Content="{DynamicResource LOCHNDPanelPageCovers}" />
                                                    <RadioButton x:Name="HndTopPageLayout" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xF0E2;"
                                                                 Content="{DynamicResource LOCHNDPanelPageLayout}" />
                                                    <RadioButton x:Name="HndTopPageTopPanel" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xE8A0;"
                                                                 Content="{DynamicResource LOCHNDPanelPageTopPanel}" />
                                                    <RadioButton x:Name="HndTopPageColors" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xE790;"
                                                                 Content="{DynamicResource LOCHNDPanelPageColors}" />
                                                    <TextBlock Style="{DynamicResource HndPanelNavHeading}" Text="{DynamicResource LOCHNDPanelSections}" />
                                                    <RadioButton x:Name="HndTopPageSectionNotes" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionNotes}" />
                                                    <RadioButton x:Name="HndTopPageSectionGenres" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionGenres}" />
                                                    <RadioButton x:Name="HndTopPageSectionCategories" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionCategories}" />
                                                    <RadioButton x:Name="HndTopPageSectionFeatures" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionFeatures}" />
                                                    <RadioButton x:Name="HndTopPageSectionTags" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionTags}" />
                                                    <RadioButton x:Name="HndTopPageSectionNews" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionNews}" />
                                                    <RadioButton x:Name="HndTopPageSectionVideo" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionVideo}" />
                                                    <RadioButton x:Name="HndTopPageSectionGameActivity" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionGameActivity}" />
                                                    <RadioButton x:Name="HndTopPageSectionCheckDlc" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionCheckDlc}" />
                                                    <RadioButton x:Name="HndTopPageSectionGameRelations" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionGameRelations}" />
                                                    <RadioButton x:Name="HndTopPageSectionWeb" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionWeb}" />
                                                    <RadioButton x:Name="HndTopPageSectionHltb" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionHltb}" />
                                                    <RadioButton x:Name="HndTopPageSectionAchievements" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionAchievements}" />
                                                    <RadioButton x:Name="HndTopPageSectionSteamScreenshots" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionSteamScreenshots}" />
                                                    <RadioButton x:Name="HndTopPageSectionScreenshotUtilities" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionScreenshotUtilities}" />
                                                    <RadioButton x:Name="HndTopPageSectionVndb" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionVndb}" />
                                                    <RadioButton x:Name="HndTopPageSectionScreenshotsVisualizer" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionScreenshotsVisualizer}" />
                                                    <RadioButton x:Name="HndTopPageSectionReviews" GroupName="HndTopPages" Style="{DynamicResource HndPanelNavButton}"
                                                                 Content="{DynamicResource LOCHNDPanelSectionReviews}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <Grid Margin="0,0,10,0" IsEnabled="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed}">
                                                    <StackPanel Visibility="{Binding IsChecked, ElementName=HndTopPageChips, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Style="{DynamicResource HndPanelPageTitle}" Text="{DynamicResource LOCHNDPanelPageChips}" />
                                                        <Border Style="{DynamicResource HndPanelPreview}">
                                                            <StackPanel>
                                                                <TextBlock Style="{DynamicResource HndPanelCardTitle}" Text="{DynamicResource LOCHNDPanelPreview}" />
                                                                <WrapPanel Width="560" HorizontalAlignment="Left">
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowReleaseDate], FallbackValue={StaticResource HeroShowReleaseDate}, TargetNullValue={StaticResource HeroShowReleaseDate}}">
                                                                        <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakReleaseDate], FallbackValue={StaticResource HeroChipBreakReleaseDate}, TargetNullValue={StaticResource HeroChipBreakReleaseDate}}" />
                                                                    </Grid>
                                                                    <Border Style="{DynamicResource HndPanelPreviewPill}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowReleaseDate], FallbackValue={StaticResource HeroShowReleaseDate}, TargetNullValue={StaticResource HeroShowReleaseDate}}"
                                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource LOCHNDPanelChipReleaseDate}" />
                                                                    </Border>
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowPlatforms], FallbackValue={StaticResource HeroShowPlatforms}, TargetNullValue={StaticResource HeroShowPlatforms}}">
                                                                        <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakPlatforms], FallbackValue={StaticResource HeroChipBreakPlatforms}, TargetNullValue={StaticResource HeroChipBreakPlatforms}}" />
                                                                    </Grid>
                                                                    <Border Style="{DynamicResource HndPanelPreviewPill}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowPlatforms], FallbackValue={StaticResource HeroShowPlatforms}, TargetNullValue={StaticResource HeroShowPlatforms}}"
                                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource LOCHNDPanelChipPlatforms}" />
                                                                    </Border>
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowSource], FallbackValue={StaticResource HeroShowSource}, TargetNullValue={StaticResource HeroShowSource}}">
                                                                        <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakSource], FallbackValue={StaticResource HeroChipBreakSource}, TargetNullValue={StaticResource HeroChipBreakSource}}" />
                                                                    </Grid>
                                                                    <Border Style="{DynamicResource HndPanelPreviewPill}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowSource], FallbackValue={StaticResource HeroShowSource}, TargetNullValue={StaticResource HeroShowSource}}"
                                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource LOCHNDPanelChipSource}" />
                                                                    </Border>
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowGenres], FallbackValue={StaticResource HeroShowGenres}, TargetNullValue={StaticResource HeroShowGenres}}">
                                                                        <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakGenres], FallbackValue={StaticResource HeroChipBreakGenres}, TargetNullValue={StaticResource HeroChipBreakGenres}}" />
                                                                    </Grid>
                                                                    <Border Style="{DynamicResource HndPanelPreviewPill}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowGenres], FallbackValue={StaticResource HeroShowGenres}, TargetNullValue={StaticResource HeroShowGenres}}"
                                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource LOCHNDPanelChipGenres}" />
                                                                    </Border>
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCategories], FallbackValue={StaticResource HeroShowCategories}, TargetNullValue={StaticResource HeroShowCategories}}">
                                                                        <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakCategories], FallbackValue={StaticResource HeroChipBreakCategories}, TargetNullValue={StaticResource HeroChipBreakCategories}}" />
                                                                    </Grid>
                                                                    <Border Style="{DynamicResource HndPanelPreviewPill}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCategories], FallbackValue={StaticResource HeroShowCategories}, TargetNullValue={StaticResource HeroShowCategories}}"
                                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource LOCHNDPanelChipCategories}" />
                                                                    </Border>
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowFeatures], FallbackValue={StaticResource HeroShowFeatures}, TargetNullValue={StaticResource HeroShowFeatures}}">
                                                                        <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakFeatures], FallbackValue={StaticResource HeroChipBreakFeatures}, TargetNullValue={StaticResource HeroChipBreakFeatures}}" />
                                                                    </Grid>
                                                                    <Border Style="{DynamicResource HndPanelPreviewPill}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowFeatures], FallbackValue={StaticResource HeroShowFeatures}, TargetNullValue={StaticResource HeroShowFeatures}}"
                                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource LOCHNDPanelChipFeatures}" />
                                                                    </Border>
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowTags], FallbackValue={StaticResource HeroShowTags}, TargetNullValue={StaticResource HeroShowTags}}">
                                                                        <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakTags], FallbackValue={StaticResource HeroChipBreakTags}, TargetNullValue={StaticResource HeroChipBreakTags}}" />
                                                                    </Grid>
                                                                    <Border Style="{DynamicResource HndPanelPreviewPill}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowTags], FallbackValue={StaticResource HeroShowTags}, TargetNullValue={StaticResource HeroShowTags}}"
                                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource LOCHNDPanelChipTags}" />
                                                                    </Border>
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowDevelopers], FallbackValue={StaticResource HeroShowDevelopers}, TargetNullValue={StaticResource HeroShowDevelopers}}">
                                                                        <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakDevelopers], FallbackValue={StaticResource HeroChipBreakDevelopers}, TargetNullValue={StaticResource HeroChipBreakDevelopers}}" />
                                                                    </Grid>
                                                                    <Border Style="{DynamicResource HndPanelPreviewPill}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowDevelopers], FallbackValue={StaticResource HeroShowDevelopers}, TargetNullValue={StaticResource HeroShowDevelopers}}"
                                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource LOCHNDPanelChipDevelopers}" />
                                                                    </Border>
                                                                    <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCompletionStatus], FallbackValue={StaticResource HeroShowCompletionStatus}, TargetNullValue={StaticResource HeroShowCompletionStatus}}">

                                                <RadioButton x:Name="HndPanelPageSectionCategories" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}"
                                                             Content="{DynamicResource LOCHNDPanelSectionCategories}" />
                                                <RadioButton x:Name="HndPanelPageSectionFeatures" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}"
                                                             Content="{DynamicResource LOCHNDPanelSectionFeatures}" />
                                                <RadioButton x:Name="HndPanelPageSectionTags" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}"
                                                             Content="{DynamicResource LOCHNDPanelSectionTags}" />
                                                <RadioButton x:Name="HndPanelPageSectionNews" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}"

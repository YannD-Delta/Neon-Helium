                                                             Content="{DynamicResource LOCHNDPanelPageHeaderBar}" />
                                                <RadioButton x:Name="HndPanelPageCovers" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xE8B9;"
                                                             Content="{DynamicResource LOCHNDPanelPageCovers}" />
                                                <RadioButton x:Name="HndPanelPageLayout" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xF0E2;"
                                                             Content="{DynamicResource LOCHNDPanelPageLayout}" />
                                                <RadioButton x:Name="HndPanelPageTopPanel" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xE8A0;"
                                                             Content="{DynamicResource LOCHNDPanelPageTopPanel}" />
                                                <RadioButton x:Name="HndPanelPageColors" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}" Tag="&#xE790;"
                                                             Content="{DynamicResource LOCHNDPanelPageColors}" />

                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <Grid Name="GameDetailsSection" Grid.Row="1">
                                    <Grid>
                                        <Border Background="{DynamicResource BackdropGlass2}" Height="380" VerticalAlignment="Top" Margin="0,0,0,0"/>
                                    </Grid>
                                    <Grid Name="DetailsGrid">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=PanelToggleButton, Path=IsChecked}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Border Background="{DynamicResource GameInfoContainerBackgroundBrush}"
                                                    Margin="20,0,30,0" Padding="15,10,15,10">
                                                    <DockPanel LastChildFill="True">
                                                        <DockPanel.Resources>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                            <Style TargetType="Label">
                                                                <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DetailsViewContainerLabelBrush}"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Margin" Value="0,4,20,4"/>
                                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                            </Style>
                                                        </DockPanel.Resources>
                                                        <Border DockPanel.Dock="Left" Name="ContainerHeightBorder"
                                                                Height="{Settings GameDetailsCoverHeight}" MinHeight="150"/>

                                                        <Grid DockPanel.Dock="Left" Margin="0,0,15,0">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=PART_ImageCover, Path=Source}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ElementName=PART_ImageCover, Path=Visibility}" Value="Collapsed">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ElementName=BackgroundChanger_PluginCoverImage, Path=Visibility}" Value="Visible">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Border BorderThickness="8" BorderBrush="Black">
                                                                <Border.CacheMode>
                                                                    <BitmapCache EnableClearType="False"
                                                                                 SnapsToDevicePixels="False" />
                                                                </Border.CacheMode>
                                                                <Border.Effect>
                                                                    <DropShadowEffect RenderingBias="Performance"
                                                                                      BlurRadius="15" ShadowDepth="0"/>
                                                                </Border.Effect>
                                                            </Border>
                                                            <Image Name="PART_ImageCover" VerticalAlignment="Bottom"
                                                                   Height="{Binding ElementName=ContainerHeightBorder, Path=ActualHeight}"
                                                                   StretchDirection="Both" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="Fant" />
                                                            <!-- Badges on the cover: HowLongToBeat main story time and achievements -->
                                                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" IsHitTestVisible="False">
                                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HltbShowOnCover], FallbackValue={StaticResource HltbShowOnCover}, TargetNullValue={StaticResource HltbShowOnCover}}">
                                                                    <Border Tag="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue=''}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border" BasedOn="{StaticResource CoverBadge}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="-">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Style="{DynamicResource CoverBadgeLabel}" Text="HLTB" />
                                                                            <TextBlock Style="{DynamicResource CoverBadgeText}" Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue=''}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[AchievementsShowOnCover], FallbackValue={StaticResource AchievementsShowOnCover}, TargetNullValue={StaticResource AchievementsShowOnCover}}">
                                                                    <Border Style="{DynamicResource CoverBadge}"
                                                                            Visibility="{PluginSettings Plugin=PlayniteAchievements, Path=HasAchievements, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Style="{DynamicResource CoverBadgeLabel}" Text="{DynamicResource LOCHNDChipAchievements}" />
                                                                            <TextBlock Style="{DynamicResource CoverBadgeText}" Text="{PluginSettings Plugin=PlayniteAchievements, Path=UnlockedCount, FallbackValue='-'}" />
                                                                            <TextBlock Style="{DynamicResource CoverBadgeText}" Text="/" />
                                                                            <TextBlock Style="{DynamicResource CoverBadgeText}" Text="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementCount, FallbackValue='-'}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                        
                                                        <ContentControl x:Name="BackgroundChanger_PluginCoverImage"
                                                                        Margin="0,0,15,0"
                                                                        DockPanel.Dock="Left" VerticalAlignment="Bottom"
                                                                        Height="{Binding ElementName=ContainerHeightBorder, Path=ActualHeight}">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataCover, FallbackValue=False}" Value="True" />
                                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableCoverImage, FallbackValue=False}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <ContentControl.Effect>
                                                                <DropShadowEffect BlurRadius="15" ShadowDepth="0"/>
                                                            </ContentControl.Effect>
                                                        </ContentControl>

                                                        <ScrollViewer Height="{Binding ElementName=ContainerHeightBorder, Path=ActualHeight}" VerticalScrollBarVisibility="Disabled"
                                                                  HorizontalScrollBarVisibility="Auto">

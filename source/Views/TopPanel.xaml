        <!-- Auto-hide (TopPanelAutoHide): a thin strip until the mouse is over it or it has the keyboard focus -->
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelAutoHide], FallbackValue=False, TargetNullValue=False}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False" />
                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <!-- From is required: MaxWidth/MaxHeight start at Infinity, which cannot be animated.
                     Leaving the condition removes the storyboard, so the panel comes back at once. -->
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="HndTopPanelHide">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight" From="110" To="10" BeginTime="0:0:0.6" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="HndTopPanelHide" />
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
        </Style.Triggers>

                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:Key="HndTopPreviewBreakCompletionStatus">
                                                        <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCompletionStatus], FallbackValue={StaticResource HeroShowCompletionStatus}, TargetNullValue={StaticResource HeroShowCompletionStatus}}">
                                                            <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakCompletionStatus], FallbackValue={StaticResource HeroChipBreakCompletionStatus}, TargetNullValue={StaticResource HeroChipBreakCompletionStatus}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:Key="HndTopPreviewBreakCommunityScore">
                                                        <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCommunityScore], FallbackValue={StaticResource HeroShowCommunityScore}, TargetNullValue={StaticResource HeroShowCommunityScore}}">
                                                            <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakCommunityScore], FallbackValue={StaticResource HeroChipBreakCommunityScore}, TargetNullValue={StaticResource HeroChipBreakCommunityScore}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:Key="HndTopPreviewBreakHltbMain">
                                                        <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowHltb], FallbackValue={StaticResource HeroShowHltb}, TargetNullValue={StaticResource HeroShowHltb}}">
                                                            <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakHltbMain], FallbackValue={StaticResource HeroChipBreakHltbMain}, TargetNullValue={StaticResource HeroChipBreakHltbMain}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:Key="HndTopPreviewBreakHltbExtra">
                                                        <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowHltb], FallbackValue={StaticResource HeroShowHltb}, TargetNullValue={StaticResource HeroShowHltb}}">
                                                            <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakHltbExtra], FallbackValue={StaticResource HeroChipBreakHltbExtra}, TargetNullValue={StaticResource HeroChipBreakHltbExtra}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:Key="HndTopPreviewBreakHltbCompletionist">
                                                        <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowHltb], FallbackValue={StaticResource HeroShowHltb}, TargetNullValue={StaticResource HeroShowHltb}}">
                                                            <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakHltbCompletionist], FallbackValue={StaticResource HeroChipBreakHltbCompletionist}, TargetNullValue={StaticResource HeroChipBreakHltbCompletionist}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:Key="HndTopPreviewBreakAchievements">
                                                        <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowAchievements], FallbackValue={StaticResource HeroShowAchievements}, TargetNullValue={StaticResource HeroShowAchievements}}">
                                                            <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakAchievements], FallbackValue={StaticResource HeroChipBreakAchievements}, TargetNullValue={StaticResource HeroChipBreakAchievements}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:Key="HndTopPreviewBreakLatestAchievement">
                                                        <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowLatestAchievement], FallbackValue={StaticResource HeroShowLatestAchievement}, TargetNullValue={StaticResource HeroShowLatestAchievement}}">
                                                            <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakLatestAchievement], FallbackValue={StaticResource HeroChipBreakLatestAchievement}, TargetNullValue={StaticResource HeroChipBreakLatestAchievement}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                    <DataTemplate x:Key="HndTopPreviewBreakRareAchievements">

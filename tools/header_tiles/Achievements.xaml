                                    <Pen Brush="{DynamicResource DetailsViewHeaderIconsFillBrush}" Thickness="1.5" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingImage.Drawing>
                </DrawingImage>
            </Image.Source>
        </Image>
    </Viewbox>
    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
        <Label x:Name="AchievementsHeaderLabel"
                Content="{DynamicResource LOCCommonLinksAchievements}"
                Style="{DynamicResource HeaderLabel}"
                HorizontalAlignment="Left" />
        <DockPanel LastChildFill="False">
            <DockPanel Margin="0,0,8,0">
                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=UnlockedCount, FallbackValue='-'}"
                        Style="{DynamicResource HeaderTextBlock}" />
                <TextBlock Text="/" Style="{DynamicResource HeaderTextBlock}" />
                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementCount, FallbackValue='-'}"
                        Style="{DynamicResource HeaderTextBlock}"/>
            </DockPanel>
            <StackPanel x:Name="DockAchievementsBar"
                        VerticalAlignment="Center"
                        MinWidth="70" HorizontalAlignment="Left">
                <ProgressBar x:Name="progressBar"
                            FontSize="10" Margin="0,0,0,0"
                            Maximum="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementCount, FallbackValue=0}"
                            Value="{PluginSettings Plugin=PlayniteAchievements, Path=UnlockedCount, FallbackValue=0}"
                            HorizontalAlignment="Left"
                            Background="#151619" Foreground="#2d73ff"
                            Height="6"
                            Style="{DynamicResource RoundedProgressBar}"
                            Width="{Binding ActualWidth, ElementName=DockAchievementsBar}" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</DockPanel>

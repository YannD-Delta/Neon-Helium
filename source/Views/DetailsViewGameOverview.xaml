                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Game.CoverImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border BorderBrush="#59FFFFFF" BorderThickness="2" CornerRadius="{DynamicResource HeroCoverCornerRadius}"
                                                Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroCoverWidth], FallbackValue={StaticResource HeroCoverWidth}, TargetNullValue={StaticResource HeroCoverWidth}}"
                                                Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroCoverHeight], FallbackValue={StaticResource HeroCoverHeight}, TargetNullValue={StaticResource HeroCoverHeight}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Game.CoverImageObjectCached}" Stretch="UniformToFill" />
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.55" RenderingBias="Performance" />
                                            </Border.Effect>
                                        </Border>
                                    </Grid>
                                    <!-- Action buttons: in the hero under the chips (0), in the header bar (1) or at the right of the band (2) -->
                                    <DockPanel x:Name="HeroActionsDock" Tag="{DynamicResource HeroActionsLocation}">
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Setter Property="Grid.Row" Value="0" />
                                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="20,0,0,20" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="1">
                                                        <Setter Property="Grid.Row" Value="1" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Margin" Value="20,10,0,10" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="2">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                        <Setter Property="Margin" Value="0,0,28,22" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <Border x:Name="HeroActionsCoverSpacer" DockPanel.Dock="Left" Margin="0,0,20,0"
                                                Width="{Binding ElementName=HeroCoverHost, Path=ActualWidth}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="{Binding ElementName=HeroCoverHost, Path=Visibility}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=HeroActionsDock, Path=Tag}" Value="2">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ElementName=HeroActionsDock, Path=Tag}" Value="1" />
                                                                <Condition Binding="{Binding ElementName=HeroCoverPlacementProbe, Path=Tag}" Value="1" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    <Grid x:Name="HeroActionsHost" HorizontalAlignment="Left">
                                        <Grid x:Name="HeroActions" HorizontalAlignment="Left" MinWidth="200"
                                              Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonWidth], FallbackValue={StaticResource HeroActionButtonWidth}, TargetNullValue={StaticResource HeroActionButtonWidth}}"
                                              Style="{DynamicResource HeroFadeInStyle}" AutomationProperties.HelpText="{Binding Game.Id, NotifyOnTargetUpdated=True}">
                                            <Grid.RenderTransform>
                                                <TranslateTransform />
                                            </Grid.RenderTransform>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Button Name="PART_ButtonPlayAction" Style="{DynamicResource HeroPlayButton}" Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" />
                                                <Button Name="PART_ButtonContextAction" Style="{DynamicResource HeroContextButton}" Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" />
                                                <Button Name="PART_ButtonMoreActions" HorizontalAlignment="Right" Content="&#xe228;"
                                                        Tag="{Binding ElementName=PART_ButtonContextAction, Path=Visibility}"
                                                        Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}"
                                                        Style="{DynamicResource HeroMoreActionsButton}" />
                                            </Grid>
                                            <Grid Grid.Column="1" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowEditButton], FallbackValue={StaticResource DetailsViewShowEditButton}, TargetNullValue={StaticResource DetailsViewShowEditButton}}">
                                                <Button x:Name="PART_ButtonEditGame" Margin="8,0,0,0" Focusable="False" Content="&#xe70f;"
                                                        ToolTip="{DynamicResource LOCEditGame}" Style="{DynamicResource HeroIconActionButton}"
                                                        Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" />
                                            </Grid>
                                            <Grid Grid.Column="2" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowFavoriteButton], FallbackValue={StaticResource DetailsViewShowFavoriteButton}, TargetNullValue={StaticResource DetailsViewShowFavoriteButton}}">
                                                <ToggleButton Name="GameFavoriteToggleButton" Margin="8,0,0,0" Focusable="False" ToolTip="{DynamicResource LOCHNDFavoriteButtonTooltip}"
                                                              Style="{DynamicResource HeroFavoriteToggle}"
                                                              Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}"
                                                              Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}"
                                                              IsChecked="{PluginSettings Plugin=ThemeExtras, Path=Game.Favorite, Mode=TwoWay, FallbackValue={StaticResource False}}" />
                                            </Grid>
                                            <!-- ThemeExtras: hide or show the game in the library (eye, crossed out when hidden) -->
                                            <Grid Grid.Column="3" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowHiddenButton], FallbackValue={StaticResource DetailsViewShowHiddenButton}, TargetNullValue={StaticResource DetailsViewShowHiddenButton}}">
                                                <ToggleButton Name="GameHiddenToggleButton" Margin="8,0,0,0" Focusable="False"
                                                              Style="{DynamicResource HeroFavoriteToggle}" Content="&#xE890;" Tag="&#xED1A;"
                                                              ToolTip="{DynamicResource LOCHNDHiddenButtonTooltip}"
                                                              Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}"
                                                              Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}"
                                                              IsChecked="{PluginSettings Plugin=ThemeExtras, Path=Game.Hidden, Mode=TwoWay, FallbackValue={StaticResource False}}" />
                                            </Grid>
                                            <!-- Steam Shortcuts: one button with the Steam client, store and community pages -->
                                            <Grid Grid.Column="4" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowSteamShortcuts], FallbackValue={StaticResource HeroShowSteamShortcuts}, TargetNullValue={StaticResource HeroShowSteamShortcuts}}">
                                                <ContentControl x:Name="SteamShortcuts_SteamGameActionsLauncher" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{PluginSettings Plugin=SteamShortcuts, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                            <!-- Game Update Status: update available dot for Steam and Epic games -->
                                            <Grid Grid.Column="5" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowUpdateStatus], FallbackValue={StaticResource HeroShowUpdateStatus}, TargetNullValue={StaticResource HeroShowUpdateStatus}}">
                                                <ContentControl x:Name="GameUpdateStatus_UpdateStatus" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    </DockPanel>
                                </Grid>

                                <!-- A section that selects or focuses something when the game changes (reviews, screenshots...) asks the
                                     page to scroll to it after Playnite scrolled back to the top: those requests stop here. -->
                                <Grid Name="GameDetailsSection" Grid.Row="1" pbeh:FocusBahaviors.BlockBringIntoViewRequest="True">
                                    <Grid>
                                        <Border Background="{DynamicResource BackdropGlass2}" Height="380" VerticalAlignment="Top" Margin="0,0,0,0"/>
                                    </Grid>
                                    <Grid Name="DetailsGrid">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=PanelToggleButton, Path=IsChecked}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Border Background="{DynamicResource SectionGlassBrush}" BorderBrush="{DynamicResource SectionGlassBorderBrush}" BorderThickness="1"
                                                    Margin="{DynamicResource PageSideMargin}" Padding="15,10,15,10" CornerRadius="{DynamicResource SectionCornerRadius}">
                                                    <DockPanel LastChildFill="True">
                                                        <DockPanel.Resources>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}" />
                                                            <Style TargetType="Label">
                                                                <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DetailsViewContainerLabelBrush}"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Margin" Value="0,4,20,4"/>
                                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                            </Style>
                                                        </DockPanel.Resources>
                                                        <Border DockPanel.Dock="Left" Name="ContainerHeightBorder"
                                                                Height="{Settings GameDetailsCoverHeight}" MinHeight="150"/>

                                                        <Grid DockPanel.Dock="Left" Margin="0,0,15,0" Tag="{DynamicResource InfoPanelStyleShowCover}">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False" />
                                                                                <Condition Binding="{Binding ElementName=HeroCoverHost, Path=Visibility}" Value="Visible" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                        <DataTrigger Binding="{Binding ElementName=PART_ImageCover, Path=Source}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ElementName=PART_ImageCover, Path=Visibility}" Value="Collapsed">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ElementName=BackgroundChanger_PluginCoverImage, Path=Visibility}" Value="Visible">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Border BorderThickness="8" BorderBrush="Black">
                                                                <Border.CacheMode>
                                                                    <BitmapCache EnableClearType="False"
                                                                                 SnapsToDevicePixels="False" />
                                                                </Border.CacheMode>
                                                                <Border.Effect>
                                                                    <DropShadowEffect RenderingBias="Performance"
                                                                                      BlurRadius="15" ShadowDepth="0"/>
                                                                </Border.Effect>
                                                            </Border>
                                                            <Image Name="PART_ImageCover" VerticalAlignment="Bottom"
                                                                   Height="{Binding ElementName=ContainerHeightBorder, Path=ActualHeight}"
                                                                   StretchDirection="Both" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="Fant" />
                                                            <!-- Badges on the cover: HowLongToBeat main story time and achievements -->
                                                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" IsHitTestVisible="False">
                                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HltbShowOnCover], FallbackValue={StaticResource HltbShowOnCover}, TargetNullValue={StaticResource HltbShowOnCover}}">
                                                                    <Border Tag="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue=''}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border" BasedOn="{StaticResource CoverBadge}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="-">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Style="{DynamicResource CoverBadgeLabel}" Text="HLTB" />
                                                                            <TextBlock Style="{DynamicResource CoverBadgeText}" Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue=''}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[AchievementsShowOnCover], FallbackValue={StaticResource AchievementsShowOnCover}, TargetNullValue={StaticResource AchievementsShowOnCover}}">
                                                                    <Border Style="{DynamicResource CoverBadge}"
                                                                            Visibility="{PluginSettings Plugin=PlayniteAchievements, Path=HasAchievements, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Style="{DynamicResource CoverBadgeLabel}" Text="{DynamicResource LOCHNDChipAchievements}" />
                                                                            <TextBlock Style="{DynamicResource CoverBadgeText}" Text="{PluginSettings Plugin=PlayniteAchievements, Path=UnlockedCount, FallbackValue='-'}" />
                                                                            <TextBlock Style="{DynamicResource CoverBadgeText}" Text="/" />
                                                                            <TextBlock Style="{DynamicResource CoverBadgeText}" Text="{PluginSettings Plugin=PlayniteAchievements, Path=AchievementCount, FallbackValue='-'}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                        
                                                        <ContentControl x:Name="BackgroundChanger_PluginCoverImage"
                                                                        Margin="0,0,15,0"
                                                                        DockPanel.Dock="Left" VerticalAlignment="Bottom"
                                                                        Height="{Binding ElementName=ContainerHeightBorder, Path=ActualHeight}">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataCover, FallbackValue=False}" Value="True" />
                                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableCoverImage, FallbackValue=False}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <ContentControl.Effect>
                                                                <DropShadowEffect BlurRadius="15" ShadowDepth="0"/>
                                                            </ContentControl.Effect>
                                                        </ContentControl>

                                                        <ScrollViewer Height="{Binding ElementName=ContainerHeightBorder, Path=ActualHeight}" VerticalScrollBarVisibility="Disabled"
                                                                  HorizontalScrollBarVisibility="Auto">
                                                            <DockPanel>
                                                                <DockPanel.Resources>
                                                                    <Style TargetType="ItemsControl">
                                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                                    </Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                                    </Style>
                                                                </DockPanel.Resources>
                                                                <ScrollViewer Name="PART_ElemDescription" MaxHeight="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewDescriptionMaxHeight], FallbackValue={StaticResource DetailsViewDescriptionMaxHeight}, TargetNullValue={StaticResource DetailsViewDescriptionMaxHeight}}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewDescriptionDockToRight], FallbackValue={StaticResource DetailsViewDescriptionDockToRight}, TargetNullValue={StaticResource DetailsViewDescriptionDockToRight}}"
                                                                              Width="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewDescriptionWidth], FallbackValue={StaticResource DetailsViewDescriptionWidth}, TargetNullValue={StaticResource DetailsViewDescriptionWidth}}" Margin="0,0,15,0">
                                                                    <ScrollViewer.Style>
                                                                        <Style TargetType="ScrollViewer">
                                                                            <Setter Property="DockPanel.Dock" Value="Left" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="true">
                                                                                    <Setter Property="DockPanel.Dock" Value="Right" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ScrollViewer.Style>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{DynamicResource LOCGameDescriptionTitle}" Margin="0,15,0,5"
                                                                               Style="{DynamicResource BaseTextBlockStyle}" Visibility="Collapsed"/>
                                                                        <Separator Background="{DynamicResource PanelSeparatorBrush}" Visibility="Collapsed"/>
                                                                        <HtmlTextView Name="PART_HtmlDescription"
                                                                                  Margin="0,5,0,5"
                                                                                  HtmlFontSize="{PluginSettings Plugin=ThemeOptions, Path=Options[FontSize], FallbackValue={StaticResource FontSize}, TargetNullValue={StaticResource FontSize}}"
                                                                                  HtmlFontFamily="{DynamicResource FontFamily}"
                                                                                  HtmlForeground="{DynamicResource DetailsViewContainerLabelColor}"
                                                                                  LinkForeground="{DynamicResource GlyphColor}"                                      
                                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                                  pbeh:FocusBahaviors.BlockBringIntoViewRequest="True"/>
                                                                    </StackPanel>
                                                                </ScrollViewer>

                                                                <ScrollViewer Margin="15,0,0,0" DockPanel.Dock="Left">
                                                                    <GridEx ColumnCount="2" AutoLayoutColumns="2" RowCount="8">
                                                                        <Label Name="PART_ElemRecentActivity" Content="{DynamicResource LOCRecentActivityLabel}" />
                                                                        <TextBlock Name="PART_TextRecentActivity" Style="{DynamicResource BaseTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        <Label Name="PART_ElemAdded" Content="{DynamicResource LOCDateAddedLabel}" />
                                                                        <TextBlock Name="PART_TextAdded" Style="{DynamicResource BaseTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        <Label Name="PART_ElemReleaseDate" Content="{DynamicResource LOCGameReleaseDateTitle}" />
                                                                        <Button Name="PART_ButtonReleaseDate" />
                                                                        <Label Name="PART_ElemLibrary" Content="{DynamicResource LOCGameProviderTitle}" />
                                                                        <Button Name="PART_ButtonLibrary" />
                                                                        <Label Name="PART_ElemSource" Content="{DynamicResource LOCSourceLabel}" />
                                                                        <Button Name="PART_ButtonSource" />
                                                                        <Label Name="PART_ElemPlatform" Content="{DynamicResource LOCPlatformTitle}" />
                                                                        <ItemsControl Name="PART_ItemsPlatforms" />
                                                                        <Label Name="PART_ElemDevelopers" Content="{DynamicResource LOCDeveloperLabel}" />
                                                                        <ItemsControl Name="PART_ItemsDevelopers" MaxWidth="{PluginSettings Plugin=ThemeOptions, Path=Options[GameInfoNarrowValueMaxWidth], FallbackValue={StaticResource GameInfoNarrowValueMaxWidth}, TargetNullValue={StaticResource GameInfoNarrowValueMaxWidth}}" />
                                                                        <Label Name="PART_ElemPublishers" Content="{DynamicResource LOCPublisherLabel}" />
                                                                        <ItemsControl Name="PART_ItemsPublishers" MaxWidth="{PluginSettings Plugin=ThemeOptions, Path=Options[GameInfoNarrowValueMaxWidth], FallbackValue={StaticResource GameInfoNarrowValueMaxWidth}, TargetNullValue={StaticResource GameInfoNarrowValueMaxWidth}}" />
                                                                    </GridEx>
                                                                </ScrollViewer>
                                                                <ScrollViewer Margin="15,0,0,0" DockPanel.Dock="Left">
                                                                    <GridEx ColumnCount="2" AutoLayoutColumns="2" RowCount="9">
                                                                        <Label Name="PART_ElemInstallSize" Content="{DynamicResource LOCInstallSizeLabel}" />
                                                                        <TextBlock Name="PART_TextInstallSize" Style="{DynamicResource BaseTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                        
                                                                        <Label Name="PART_ElemInstallDirectory" Content="{DynamicResource LOCGameInstallDirTitle}" />
                                                                        <Button Name="PART_ButtonInstallDirectory" HorizontalAlignment="Left" MaxWidth="{PluginSettings Plugin=ThemeOptions, Path=Options[GameInfoWideValueMaxWidth], FallbackValue={StaticResource GameInfoWideValueMaxWidth}, TargetNullValue={StaticResource GameInfoWideValueMaxWidth}}" />
                                                                        
                                                                        <Label Name="PART_ElemSeries" Content="{DynamicResource LOCSeriesLabel}" />
                                                                        <ItemsControl Name="PART_ItemsSeries" MaxWidth="{PluginSettings Plugin=ThemeOptions, Path=Options[GameInfoWideValueMaxWidth], FallbackValue={StaticResource GameInfoWideValueMaxWidth}, TargetNullValue={StaticResource GameInfoWideValueMaxWidth}}" />

                                                                        <Label Name="PART_ElemRegion" Content="{DynamicResource LOCRegionLabel}" />
                                                                        <ItemsControl Name="PART_ItemsRegions" />

                                                                        <Label Name="PART_ElemVersion" Content="{DynamicResource LOCVersionLabel}" />
                                                                        <Button Name="PART_ButtonVersion" VerticalAlignment="Center" />
                                                                        <Label Name="PART_ElemUserScore" Content="{DynamicResource LOCUserScore}" />
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Visibility="{Binding ElementName=PART_TextUserScore, Path=Visibility}">
                                                                            <TextBlock Name="PART_TextUserScore" VerticalAlignment="Center"
                                                                                       Style="{DynamicResource TextBlockGameScore}" />
                                                                            <ContentControl Content="{Binding Game.UserScore}"
                                                                                            Padding="6,0,0,4"
                                                                                            HorizontalAlignment="Left"
                                                                                            VerticalAlignment="Center"
                                                                                            Background="Transparent"
                                                                                            Foreground="{Binding ElementName=PART_TextUserScore, Path=Foreground}"
                                                                                            Height="{Binding ElementName=PART_TextUserScore, Path=ActualHeight}"
                                                                                            ContentTemplate="{StaticResource FiveStarScoreTemplate}"/>
                                                                        </StackPanel>

                                                                        <Label Name="PART_ElemCommunityScore" Content="{DynamicResource LOCCommunityScore}" />
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Visibility="{Binding ElementName=PART_TextCommunityScore, Path=Visibility}">
                                                                            <TextBlock Name="PART_TextCommunityScore" VerticalAlignment="Center"
                                                                                       Style="{DynamicResource TextBlockGameScore}" />
                                                                            <ContentControl Content="{Binding Game.CommunityScore}"
                                                                                            Padding="6,0,0,4"
                                                                                            HorizontalAlignment="Left"
                                                                                            VerticalAlignment="Center"
                                                                                            Background="Transparent"
                                                                                            Foreground="{Binding ElementName=PART_TextCommunityScore, Path=Foreground}"
                                                                                            Height="{Binding ElementName=PART_TextCommunityScore, Path=ActualHeight}"
                                                                                            ContentTemplate="{StaticResource FiveStarScoreTemplate}"/>
                                                                        </StackPanel>

                                                                        <Label Name="PART_ElemCriticScore" Content="{DynamicResource LOCCriticScore}" />
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Visibility="{Binding ElementName=PART_TextCriticScore, Path=Visibility}">
                                                                            <TextBlock Name="PART_TextCriticScore" VerticalAlignment="Center"
                                                                                       Style="{DynamicResource TextBlockGameScore}" />
                                                                            <ContentControl Content="{Binding Game.CriticScore}"
                                                                                            Padding="6,0,0,4"
                                                                                            HorizontalAlignment="Left"
                                                                                            VerticalAlignment="Center"
                                                                                            Background="Transparent"
                                                                                            Foreground="{Binding ElementName=PART_TextCriticScore, Path=Foreground}"
                                                                                            Height="{Binding ElementName=PART_TextCriticScore, Path=ActualHeight}"
                                                                                            ContentTemplate="{StaticResource FiveStarScoreTemplate}"/>
                                                                        </StackPanel>

                                                                        <Label Name="PART_ElemAgeRating" Content="{DynamicResource LOCAgeRatingLabel}" />
                                                                        <ItemsControl Name="PART_ItemsAgeRatings" />
                                                                    </GridEx>
                                                                </ScrollViewer>
                                                            </DockPanel>
                                                        </ScrollViewer>

                                                    </DockPanel>
                                                </Border>
                                                <Border Style="{DynamicResource OutlineBorderSidePanelsBorder}"
                                                        CornerRadius="0"
                                                        Margin="20,0,30,0" Padding="15,10,15,10" />
                                            </Grid>
                                        </Grid>

                                        <Grid Margin="{DynamicResource PageLinksMargin}" Grid.Row="2">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Settings DetailsVisibility.Links}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.Links}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.Links.Count, TargetNullValue=0}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border Style="{DynamicResource OutlineBorderSidePanelsBorder}" />
                                            <Border Style="{DynamicResource OutlineBorder}" />

                                            <ItemsControl ItemsSource="{Binding Game.Links}" Margin="0,5,0,5">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <RadioButton x:Name="HndPanelPageSectionWeb" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}"
                                                             Content="{DynamicResource LOCHNDPanelSectionWeb}" />
                                                <RadioButton x:Name="HndPanelPageSectionHltb" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}"
                                                             Content="{DynamicResource LOCHNDPanelSectionHltb}" />
                                                <RadioButton x:Name="HndPanelPageSectionAchievements" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}"
                                                             Content="{DynamicResource LOCHNDPanelSectionAchievements}" />
                                                <RadioButton x:Name="HndPanelPageSectionSteamScreenshots" GroupName="HndPanelPages" Style="{DynamicResource HndPanelNavButton}"

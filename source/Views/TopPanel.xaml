                                    <Button Style="{DynamicResource TopPanelThemeColorsButtonStyle}"
                                            ToolTip="{DynamicResource LOCHNDThemeColorsButton}"
                                            Visibility="{PluginStatus Plugin=playnite-thememodifier-plugin, Status=Installed}"

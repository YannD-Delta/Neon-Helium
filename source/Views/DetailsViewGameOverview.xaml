                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionGameRelations}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionWeb}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionHltb}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionAchievements}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionSteamScreenshots}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionScreenshotUtilities}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionVndb}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionScreenshotsVisualizer}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=HndPanelPageSectionReviews}" Value="True">
                                                <Setter Property="IsOpen" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

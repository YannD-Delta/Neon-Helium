                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Tabs mode (DetailsViewTabsMode): each section shows in the tab set in its gear (DetailsViewTab*), 0 = every tab -->
                                            <WrapPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14" Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewTabsMode], FallbackValue={StaticResource DetailsViewTabsMode}, TargetNullValue={StaticResource DetailsViewTabsMode}}">
                                                <RadioButton x:Name="DetailsTabAll" GroupName="HndDetailsTabs" Style="{DynamicResource DetailsTabButton}" IsChecked="True" Content="{DynamicResource LOCHNDTabAll}" />
                                                <RadioButton x:Name="DetailsTabAbout" GroupName="HndDetailsTabs" Style="{DynamicResource DetailsTabButton}" Content="{DynamicResource LOCHNDTabAbout}" />
                                                <RadioButton x:Name="DetailsTabMedia" GroupName="HndDetailsTabs" Style="{DynamicResource DetailsTabButton}" Content="{DynamicResource LOCHNDTabMedia}" />
                                                <RadioButton x:Name="DetailsTabStats" GroupName="HndDetailsTabs" Style="{DynamicResource DetailsTabButton}" Content="{DynamicResource LOCHNDTabStats}" />
                                                <RadioButton x:Name="DetailsTabCommunity" GroupName="HndDetailsTabs" Style="{DynamicResource DetailsTabButton}" Content="{DynamicResource LOCHNDTabCommunity}" />
                                            </WrapPanel>

                                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <!-- rows 19 and up: sections folded at the bottom because their information is shown above -->
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />

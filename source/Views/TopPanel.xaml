                                        Command="{PluginSettings Plugin=PlayniteAchievements, Path=OpenAchievementWindow, FallbackValue={x:Null}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{DynamicResource FontIcoFont}" Text="&#xEDD7;" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource GlyphBrush}" />
                                            <TextBlock Text="{DynamicResource LOCHNDCollectorLevel}" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevel, FallbackValue=0}" Margin="3,0,0,0"
                                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ProgressBar Height="2" Margin="0,3,0,0" Minimum="0" Maximum="100" IsHitTestVisible="False"
                                                     Value="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevelProgress, FallbackValue=0}"

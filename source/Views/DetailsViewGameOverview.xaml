                                                             Content="{DynamicResource LOCHNDPanelSectionReviews}" />
                                                <RadioButton x:Name="HndPanelPageNone" GroupName="HndPanelPages" Visibility="Collapsed" IsChecked="True" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <Grid Margin="0,0,10,0" IsEnabled="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed}">
                                                <StackPanel Visibility="{Binding IsChecked, ElementName=HndPanelPageChips, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{DynamicResource HndPanelPageTitle}" Text="{DynamicResource LOCHNDPanelPageChips}" />

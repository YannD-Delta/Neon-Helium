    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xef03;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xefcf;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>
    
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <TextBlock Text="&#xed12;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DataTemplate>
    
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="#25272d" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="6,6,6,6" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Stretch="Uniform" Width="20" Height="20"
                                     VerticalAlignment="Center">
                                <Canvas Width="36" Height="36">
                                    <Path Fill="{TemplateBinding Foreground}"
                                          Data="M34 7V11H2V7H34ZM6 20H30V16H6V20ZM10 29H26V25H10V29Z"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       Margin="3,0,0,0" VerticalAlignment="Center"
                                       Name="TextFilter" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                            <Setter Property="Foreground" Value="#ccffffff" />
                            <Setter Property="Background" Value="#1e90ff" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="TextFilter" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TopPanelItemIsMouseOverForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="6,6,6,6" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="#25272d" />
        <Setter Property="Foreground" Value="#808080" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Border" CornerRadius="2"
                            VerticalAlignment="Center"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Stretch="Uniform" Width="20" Height="20"
                                     VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Canvas Width="36" Height="36">
                                    <Path Fill="{TemplateBinding Foreground}"
                                          Data="M32 24V26H4V24L8 19V12C8 9.34784 9.05357 6.8043 10.9289 4.92893C12.8043 3.05357 15.3478 2 18 2C20.6522 2 23.1957 3.05357 25.0711 4.92893C26.9464 6.8043 28 9.34784 28 12V19L32 24Z"/>
                                    <Path Fill="{TemplateBinding Foreground}"
                                          Data="M18 34C19.2396 33.9986 20.4483 33.6133 21.46 32.897C22.4718 32.1807 23.2368 31.1687 23.65 30H12.35C12.7632 31.1687 13.5282 32.1807 14.54 32.897C15.5517 33.6133 16.7604 33.9986 18 34Z"/>
                                </Canvas>
                            </Viewbox>
                            <Border CornerRadius="3" MinWidth="15" Height="15"
                                    Margin="3,0,0,0" Background="OrangeRed" Padding="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Api Notifications.Count}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3e4047" />
                <Setter Property="Foreground" Value="#ccffffff" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Background" Value="{DynamicResource TopPanelBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelHeight], FallbackValue={StaticResource TopPanelHeight}, TargetNullValue={StaticResource TopPanelHeight}}" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{TemplateBinding Background}"
                            d:DesignWidth="1280"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings SidebarPosition}" Value="Top">
                                        <Setter Property="BorderThickness" Value="0,1,0,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Margin="0,3,110,3">
                            <Border x:Name="PART_ElemMainMenu" Background="Transparent"
                                    DockPanel.Dock="Left" Margin="5,0,0,0" Cursor="Hand"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Image Source="{ThemeFile 'Images/applogo.png'}"
                                       Height="40" RenderOptions.BitmapScalingMode="Fant"
                                       Margin="10,0,10,0"/>
                            </Border>

                            <SearchBox x:Name="PART_TextMainSearch"
                                       Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}"
                                       Margin="0,6,0,6" DockPanel.Dock="Left"
                                       WindowChrome.IsHitTestVisibleInChrome="True"
                                       Width="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelSearchBoxWidthHelium], FallbackValue={StaticResource TopPanelSearchBoxWidthHelium}, TargetNullValue={StaticResource TopPanelSearchBoxWidthHelium}}"
                                       MaxWidth="{Settings DetailsListWitdh}" />

                            <Border Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowNavigationButtons], FallbackValue={StaticResource ShowNavigationButtons}, TargetNullValue={StaticResource ShowNavigationButtons}}"
                                    DockPanel.Dock="Left"
                                    Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}"
                                            Margin="{Binding ElementName=PART_ToggleNotifications, Path=Margin}"
                                            Orientation="Horizontal">
                                    <Button Style="{DynamicResource TopPanelNavigateBackButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.BackCommand, FallbackValue={x:Null}}" />
                                    <Button Style="{DynamicResource TopPanelNavigateForwardButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.ForwardCommand, FallbackValue={x:Null}}" />
                                </StackPanel>
                            </Border>
                            
                            <!-- Shortcuts to the theme settings: Theme Options (layout) and ThemeModifier (colors). Need ThemeExtras. -->
                            <!-- Theme workshop: live settings popup (always available) -->
                            <!-- BEGIN generated workshop: edit tools/options_spec.yaml (workshop), then run tools/build_options.py -->
                            <Grid VerticalAlignment="Center" Margin="{Binding ElementName=PART_ToggleNotifications, Path=Margin}">
                                <ToggleButton x:Name="ThemeWorkshopToggle" Style="{DynamicResource TopPanelWorkshopToggleStyle}"
                                              ToolTip="{DynamicResource LOCHNDWorkshopTooltip}" />
                                <Popup IsOpen="{Binding IsChecked, ElementName=ThemeWorkshopToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                                       PlacementTarget="{Binding ElementName=ThemeWorkshopToggle}" Placement="Bottom" VerticalOffset="6">
                                    <Border Style="{DynamicResource QuickSettingsPanel}" Width="460" MaxWidth="460">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Style="{DynamicResource QuickSettingsTitle}" Text="{DynamicResource LOCHNDWorkshopTitle}" />
                                                <TextBlock Style="{DynamicResource QuickSettingsHint}" Text="{DynamicResource LOCHNDQuickNeedsThemeOptions}"
                                                           Visibility="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDWorkshopIntro}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextBrushDarker}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,4" />
                                                <StackPanel IsEnabled="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed}">
                                                    <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopArtworkheader}" />
                                                    <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeroMinHeight}">
                                                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeroMinHeight}" Margin="0,0,0,2" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                   Text="{Binding Value, ElementName=WorkshopHeroMinHeightSlider, StringFormat={}{0:0}}" />
                                                        <Slider x:Name="WorkshopHeroMinHeightSlider" Minimum="300" Maximum="900" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroMinHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeroMinHeight}}" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeroActionButtonWidth}">
                                                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeroActionButtonWidth}" Margin="0,0,0,2" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                   Text="{Binding Value, ElementName=WorkshopHeroActionButtonWidthSlider, StringFormat={}{0:0}}" />
                                                        <Slider x:Name="WorkshopHeroActionButtonWidthSlider" Minimum="200" Maximum="600" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonWidth], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeroActionButtonWidth}}" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeroActionButtonHeight}">
                                                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeroActionButtonHeight}" Margin="0,0,0,2" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                   Text="{Binding Value, ElementName=WorkshopHeroActionButtonHeightSlider, StringFormat={}{0:0}}" />
                                                        <Slider x:Name="WorkshopHeroActionButtonHeightSlider" Minimum="28" Maximum="72" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeroActionButtonHeight}}" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipGameLogoMaxWidth}">
                                                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptGameLogoMaxWidth}" Margin="0,0,0,2" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                   Text="{Binding Value, ElementName=WorkshopGameLogoMaxWidthSlider, StringFormat={}{0:0}}" />
                                                        <Slider x:Name="WorkshopGameLogoMaxWidthSlider" Minimum="100" Maximum="2000" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Value="{PluginSettings Plugin=ThemeOptions, Path=Options[GameLogoMaxWidth], Mode=TwoWay, Delay=150, FallbackValue={StaticResource GameLogoMaxWidth}}" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipGameLogoMaxHeight}">
                                                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptGameLogoMaxHeight}" Margin="0,0,0,2" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                   Text="{Binding Value, ElementName=WorkshopGameLogoMaxHeightSlider, StringFormat={}{0:0}}" />
                                                        <Slider x:Name="WorkshopGameLogoMaxHeightSlider" Minimum="50" Maximum="1000" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Value="{PluginSettings Plugin=ThemeOptions, Path=Options[GameLogoMaxHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource GameLogoMaxHeight}}" />
                                                    </DockPanel>
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowEditButton}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowEditButton}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowEditButton], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowEditButton}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowFavoriteButton}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowFavoriteButton}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowFavoriteButton], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowFavoriteButton}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowHiddenButton}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowHiddenButton}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowHiddenButton], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowHiddenButton}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHeroShowSteamShortcuts}" ToolTip="{DynamicResource LOCHNDTipHeroShowSteamShortcuts}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowSteamShortcuts], Mode=TwoWay, FallbackValue={StaticResource HeroShowSteamShortcuts}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHeroShowUpdateStatus}" ToolTip="{DynamicResource LOCHNDTipHeroShowUpdateStatus}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowUpdateStatus], Mode=TwoWay, FallbackValue={StaticResource HeroShowUpdateStatus}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewAllowUseOfLogos}" ToolTip="{DynamicResource LOCHNDTipDetailsViewAllowUseOfLogos}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewAllowUseOfLogos], Mode=TwoWay, FallbackValue={StaticResource DetailsViewAllowUseOfLogos}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewDisplayGameNameIfLogoVisible}" ToolTip="{DynamicResource LOCHNDTipDetailsViewDisplayGameNameIfLogoVisible}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewDisplayGameNameIfLogoVisible], Mode=TwoWay, FallbackValue={StaticResource DetailsViewDisplayGameNameIfLogoVisible}}" />
                                                    <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopChips}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHeroShowInfoLine}" ToolTip="{DynamicResource LOCHNDTipHeroShowInfoLine}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowInfoLine], Mode=TwoWay, FallbackValue={StaticResource HeroShowInfoLine}}" />
                                                    <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeroInfoLineMaxWidth}">
                                                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeroInfoLineMaxWidth}" Margin="0,0,0,2" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                   Text="{Binding Value, ElementName=WorkshopHeroInfoLineMaxWidthSlider, StringFormat={}{0:0}}" />
                                                        <Slider x:Name="WorkshopHeroInfoLineMaxWidthSlider" Minimum="300" Maximum="2000" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroInfoLineMaxWidth], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeroInfoLineMaxWidth}}" />
                                                    </DockPanel>
                                                    <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopHeaderbar}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowHeaderBar}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowHeaderBar}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowHeaderBar], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowHeaderBar}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowLastPlayed}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowLastPlayed}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowLastPlayed], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowLastPlayed}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowPlayTime}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowPlayTime}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowPlayTime], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowPlayTime}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowCompletionStatus}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowCompletionStatus}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowCompletionStatus], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowCompletionStatus}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowAchievementsSummary}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowAchievementsSummary}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowAchievementsSummary], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowAchievementsSummary}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHltbShowInHeaderBar}" ToolTip="{DynamicResource LOCHNDTipHltbShowInHeaderBar}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HltbShowInHeaderBar], Mode=TwoWay, FallbackValue={StaticResource HltbShowInHeaderBar}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowUserRating}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowUserRating}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowUserRating], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowUserRating}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowInfoButton}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowInfoButton}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowInfoButton], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowInfoButton}}" />
                                                    <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeaderButtonSize}">
                                                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeaderButtonSize}" Margin="0,0,0,2" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                   Text="{Binding Value, ElementName=WorkshopHeaderButtonSizeSlider, StringFormat={}{0:0}}" />
                                                        <Slider x:Name="WorkshopHeaderButtonSizeSlider" Minimum="20" Maximum="56" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeaderButtonSize], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeaderButtonSize}}" />
                                                    </DockPanel>
                                                    <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopCover}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHltbShowOnCover}" ToolTip="{DynamicResource LOCHNDTipHltbShowOnCover}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HltbShowOnCover], Mode=TwoWay, FallbackValue={StaticResource HltbShowOnCover}}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptAchievementsShowOnCover}" ToolTip="{DynamicResource LOCHNDTipAchievementsShowOnCover}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[AchievementsShowOnCover], Mode=TwoWay, FallbackValue={StaticResource AchievementsShowOnCover}}" />
                                                    <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopGamelistandcovers}" />
                                                    <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptLibraryListShowHltb}" ToolTip="{DynamicResource LOCHNDTipLibraryListShowHltb}"
                                                              IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[LibraryListShowHltb], Mode=TwoWay, FallbackValue={StaticResource LibraryListShowHltb}}" />

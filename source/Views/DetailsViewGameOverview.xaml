<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid>
                    <!-- Liquid glass: the artwork, blurred and dimmed, fixed behind the whole page (it does not scroll).
                         Rendered at a tenth of its size and scaled up, which blurs it at a low cost. -->
                    <Grid x:Name="PageGlassBackground" IsHitTestVisible="False" ClipToBounds="True" Opacity="{DynamicResource PageGlassOpacity}">
                        <Border>
                            <Border.Background>
                                <VisualBrush Visual="{Binding ElementName=HeroArtworkLayer}" Stretch="UniformToFill" AlignmentY="Top" />
                            </Border.Background>
                            <Border.CacheMode>
                                <BitmapCache EnableClearType="False" RenderAtScale="0.1" SnapsToDevicePixels="False" />
                            </Border.CacheMode>
                            <Border.Effect>
                                <BlurEffect Radius="{DynamicResource PageGlassBlurRadius}" KernelType="Gaussian" RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource GlyphBrush}" Opacity="{DynamicResource PageGlassTintOpacity}" />
                        <Border Background="Black" Opacity="{DynamicResource PageGlassScrimOpacity}" />
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.3" />
                                    <GradientStop Color="#66000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource DetailsScrollViewer}"
                                  d:DesignWidth="1280"
                                  d:DesignHeight="1280"
                                  d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}"
                                  x:Name="PART_ScrollViewHost">
                        <Grid Margin="0,0,0,40">
                            <StackPanel Name="BackgroundBlurPanel">
                                <Border Height="{Binding ElementName=HeaderImagesGrid, Path=ActualHeight}" Margin="{DynamicResource HeroCardMargin}" />
                                <Border Name="FastBlurGrid" Opacity="{DynamicResource DetailsViewBackgroundBlurOpacity}" VerticalAlignment="Top">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5, 0.0" EndPoint="0.5, 1.0" >
                                            <GradientStop Color="Black" Offset="0.8" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                    <Grid x:Name="MainGrid" Height="600">
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0, 0, 3840, 800" />
                                        </Grid.Clip>
                                        <Grid.CacheMode>
                                            <BitmapCache EnableClearType="False" 
                                                    RenderAtScale="0.05"
                                                    SnapsToDevicePixels="False" />
                                        </Grid.CacheMode>
                                        <Border RenderTransformOrigin="0.5,0.5">
                                            <Border.Background>
                                                <VisualBrush Visual="{Binding ElementName=BorderImageBackground}" Stretch="UniformToFill"
                                                             AlignmentY="Center" AlignmentX="Center"/>
                                            </Border.Background>
                                            <Border.Effect>
                                                <BlurEffect Radius="100" KernelType="Gaussian" RenderingBias="Performance"/>
                                            </Border.Effect>
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="-1" ScaleY="1" />
                                                    <RotateTransform Angle="180" />
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Artwork card: the black mask drawn first is also the opacity mask, so every layer gets the rounded corners -->
                                <Grid Grid.Row="0" Height="{Binding ElementName=HeaderImagesGrid, Path=ActualHeight}" VerticalAlignment="Top"
                                      Margin="{DynamicResource HeroCardMargin}" Name="BorderImageBackground">
                                    <Grid.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=HeroCardMask}" />
                                    </Grid.OpacityMask>
                                    <Border x:Name="HeroCardMask" Background="Black" CornerRadius="{DynamicResource HeroCardCornerRadius}" />
                                    <!-- Clipped with a background so its bounds are exactly the card: the blur copies below map 1:1 onto it -->
                                    <Grid x:Name="HeroArtworkLayer" ClipToBounds="True" Background="Transparent">
                                        <Grid.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5, 0.0" EndPoint="0.5, 1.0" >
                                                <GradientStop Color="Black" Offset="{DynamicResource HeroFadeStart}"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.OpacityMask>
                                        <Grid Background="#141414">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Settings DetailsVisibility.BackgroundImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        </Grid>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataBackground, FallbackValue=False}" Value="True" />
                                                                <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableBackgroundImage, FallbackValue=False}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" Effect="{DynamicResource HeroBackgroundEffect}"
                                                       HorizontalAlignment="{DynamicResource DetailsViewBackgroundHorizontalAlignment}"
                                                       VerticalAlignment="{DynamicResource DetailsViewBackgroundVerticalAlignment}" />
                                        </Border>

                                        <!-- BackgroundChanger plugin background -->
                                        <ContentControl x:Name="BackgroundChanger_PluginBackgroundImage"
                                                        HorizontalAlignment="{DynamicResource DetailsViewBackgroundHorizontalAlignment}"
                                                        VerticalAlignment="{DynamicResource DetailsViewBackgroundVerticalAlignment}" />
                                    </Grid>
                                    <!-- Progressive blur: a light and a strong blurred copy of the artwork, faded in towards the bottom -->
                                    <Border x:Name="HeroBlurSoft" IsHitTestVisible="False" Opacity="{DynamicResource HeroBlurOpacity}">
                                        <Border.Background>
                                            <VisualBrush Visual="{Binding ElementName=HeroArtworkLayer}" Stretch="Fill" />
                                        </Border.Background>
                                        <Border.Effect>
                                            <BlurEffect Radius="{DynamicResource HeroBlurRadiusSoft}" KernelType="Gaussian" RenderingBias="Performance" />
                                        </Border.Effect>
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="{DynamicResource HeroBlurStart}" />
                                                <GradientStop Color="Black" Offset="{DynamicResource HeroBlurMid}" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <Border x:Name="HeroBlurStrong" IsHitTestVisible="False" Opacity="{DynamicResource HeroBlurOpacity}">
                                        <Border.Background>
                                            <VisualBrush Visual="{Binding ElementName=HeroArtworkLayer}" Stretch="Fill" />
                                        </Border.Background>
                                        <Border.Effect>
                                            <BlurEffect Radius="{DynamicResource HeroBlurRadius}" KernelType="Gaussian" RenderingBias="Performance" />
                                        </Border.Effect>
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="{DynamicResource HeroBlurMid}" />
                                                <GradientStop Color="Black" Offset="{DynamicResource HeroBlurFull}" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <!-- Tint over the blurred band: accent color and white frost -->
                                    <Border Background="{DynamicResource GlyphBrush}" Opacity="{DynamicResource HeroTintAccentOpacity}" IsHitTestVisible="False">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="{DynamicResource HeroBlurStart}" />
                                                <GradientStop Color="Black" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <Border Background="White" Opacity="{DynamicResource HeroTintLightOpacity}" IsHitTestVisible="False">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="Transparent" Offset="{DynamicResource HeroBlurStart}" />
                                                <GradientStop Color="Black" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="0" Name="DetailsTop" VerticalAlignment="Top" Margin="{DynamicResource HeroCardMargin}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Name="HeaderImagesGrid" Height="{Settings CalculatedGameDetailsIndentation}" MinHeight="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroMinHeight], FallbackValue={StaticResource HeroMinHeight}, TargetNullValue={StaticResource HeroMinHeight}}">
                                        <!-- Dune-style shade so the actions stay readable on bright artwork -->
                                        <Border Background="Black" Opacity="{DynamicResource HeroShadeOpacity}" IsHitTestVisible="False"
                                                CornerRadius="{DynamicResource HeroCardCornerRadius}">
                                            <Border.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                                    <GradientStop Color="White" Offset="0" />
                                                    <GradientStop Color="Transparent" Offset="0.55" />
                                                </LinearGradientBrush>
                                            </Border.OpacityMask>
                                        </Border>
                                        <Border BorderBrush="White" BorderThickness="{DynamicResource HeroCardBorderThickness}" Opacity="{DynamicResource HeroCardBorderOpacity}"
                                                CornerRadius="{DynamicResource HeroCardCornerRadius}" IsHitTestVisible="False" />
                                        <Border Panel.ZIndex="99">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableVideoPlayer, FallbackValue=False}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControlAlternative" Margin="10" HorizontalAlignment="Left"/>
                                        </Border>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Margin="20,0,0,0" Width="{Binding ElementName=HeroCoverHost, Path=ActualWidth}"
                                                    Visibility="{Binding ElementName=HeroCoverHost, Path=Visibility}" />
                                            <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl"
                                                            Margin="20,20,30,20" MaxWidth="{PluginSettings Plugin=ThemeOptions, Path=Options[GameLogoMaxWidth], FallbackValue={StaticResource GameLogoMaxWidth}, TargetNullValue={StaticResource GameLogoMaxWidth}}" MaxHeight="{PluginSettings Plugin=ThemeOptions, Path=Options[GameLogoMaxHeight], FallbackValue={StaticResource GameLogoMaxHeight}, TargetNullValue={StaticResource GameLogoMaxHeight}}"
                                                            Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewAllowUseOfLogos], FallbackValue={StaticResource DetailsViewAllowUseOfLogos}, TargetNullValue={StaticResource DetailsViewAllowUseOfLogos}}" 
                                                            Style="{DynamicResource ControlPanelBoolTagToVisibility}"/>
                                        </DockPanel>

                                        <!-- Information band: room for the header cover on the left and for the buttons on the right (actions location 2) -->
                                        <DockPanel VerticalAlignment="Bottom">
                                        <Border x:Name="HeroBandCoverSpacer" DockPanel.Dock="Left" Margin="20,0,0,0"
                                                Width="{Binding ElementName=HeroCoverHost, Path=ActualWidth}"
                                                Visibility="{Binding ElementName=HeroCoverHost, Path=Visibility}" />
                                        <Border x:Name="HeroBandActionsSpacer" DockPanel.Dock="Right" Margin="20,0,28,0"
                                                Width="{Binding ElementName=HeroActionsHost, Path=ActualWidth}" Tag="{DynamicResource HeroActionsLocation}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="2">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Margin="20,0,10,20" VerticalAlignment="Bottom"
                                                    Style="{DynamicResource HeroFadeInStyle}" AutomationProperties.HelpText="{Binding Game.Id, NotifyOnTargetUpdated=True}">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform />
                                            </StackPanel.RenderTransform>
                                            <!--<Image Name="PART_ImageIcon" MaxHeight="48" MaxWidth="48"
                                                   DockPanel.Dock="Left" Margin="0,0,20,0"
                                                   VerticalAlignment="Bottom"
                                                   RenderOptions.BitmapScalingMode="Fant" />-->
                                            <DockPanel LastChildFill="False">
                                                <ContentControl x:Name="ScreenshotsVisualizer_PluginButton" Height="40" VerticalAlignment="Bottom" Margin="0,0,10,0" DockPanel.Dock="Left" Opacity="0.80"
                                                            Visibility="{PluginSettings Plugin=ScreenshotsVisualizer, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ContentControl x:Name="ScreenshotUtilities_ButtonControl" Height="40" FontSize="22" VerticalAlignment="Bottom" Margin="0,0,10,0" DockPanel.Dock="Left" Opacity="0.80"
                                                            Visibility="{PluginSettings Plugin=ScreenshotUtilities, Path=IsButtonControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ContentControl x:Name="SystemChecker_PluginButton" Height="40" VerticalAlignment="Bottom" Margin="0,0,10,0" DockPanel.Dock="Left" Opacity="0.80"
                                                            Visibility="{PluginSettings Plugin=SystemChecker, Path=EnableIntegrationButton, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ContentControl x:Name="CheckLocalizations_PluginButton" Height="40" VerticalAlignment="Bottom" Margin="0,0,10,0" DockPanel.Dock="Left" Opacity="0.80"
                                                            Visibility="{PluginSettings Plugin=CheckLocalizations, Path=EnableIntegrationButton, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ContentControl x:Name="CheckDlc_PluginButton" Height="40" VerticalAlignment="Bottom" Margin="0,0,10,0" DockPanel.Dock="Left" Opacity="0.80"
                                                            Visibility="{PluginSettings Plugin=CheckDlc, Path=EnableIntegrationButton, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ContentControl x:Name="LibraryManagement_PluginFeaturesIconList" Height="30" Margin="0,0,20,0"
                                                            VerticalAlignment="Bottom" DockPanel.Dock="Right" Opacity="0.80"
                                                            Visibility="{PluginSettings Plugin=LibraryManagement, Path=EnableIntegrationFeatures, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ContentControl.Effect>
                                                        <DropShadowEffect BlurRadius="5" RenderingBias="Performance"
                                                                      ShadowDepth="0" Color="DarkGray" />
                                                    </ContentControl.Effect>
                                                </ContentControl>
                                            </DockPanel>
                                            <Border DockPanel.Dock="Left" Margin="0,10,0,0"
                                                    Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewDisplayGameNameIfLogoVisible], FallbackValue={StaticResource DetailsViewDisplayGameNameIfLogoVisible}, TargetNullValue={StaticResource DetailsViewDisplayGameNameIfLogoVisible}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="False" />
                                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_LogoLoaderControl, Path=Visibility, FallbackValue=Collapsed}" Value="Visible" />
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontFamily="{DynamicResource FontFamily}" Name="PART_TextDisplayName"
                                                       FontSize="{PluginSettings Plugin=ThemeOptions, Path=Options[FontSizeLargest], FallbackValue={StaticResource FontSizeLargest}, TargetNullValue={StaticResource FontSizeLargest}}"
                                                       FontWeight="Medium"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="White">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="Black" ShadowDepth="0" Opacity="1"
                                                                          BlurRadius="10" Direction="0"
                                                                          RenderingBias="Performance" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Border>
                                            <!-- Hero footer (Dune): info chips. Each chip has its own option. -->
                                            <Grid x:Name="HeroFooter" Margin="0,14,0,0" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Quick settings for the chips line -->
                                                <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,0,8,0">
                                                    <!-- BEGIN gear menu Chips: edit tools/options_spec.yaml (section_menus), then run tools/build_options.py. -->
                                                    <ToggleButton x:Name="QuickSettingsChips" Style="{DynamicResource SectionQuickSettingsToggle}" VerticalAlignment="Center" />
                                                    <Popup IsOpen="{Binding IsChecked, ElementName=QuickSettingsChips, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                                                           PlacementTarget="{Binding ElementName=QuickSettingsChips}" Placement="Left">
                                                        <Border Style="{DynamicResource QuickSettingsPanel}">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                                                                <StackPanel>
                                                                    <TextBlock Style="{DynamicResource QuickSettingsTitle}" Text="{DynamicResource LOCHNDQuickChipsTitle}" />
                                                                    <TextBlock Style="{DynamicResource QuickSettingsHint}" Text="{DynamicResource LOCHNDQuickNeedsThemeOptions}"
                                                                               Visibility="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                                                                    <StackPanel IsEnabled="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed}">
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowInfoLine], Mode=TwoWay, FallbackValue={StaticResource HeroShowInfoLine}, TargetNullValue={StaticResource HeroShowInfoLine}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowInfoLine}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipsOpenSections], Mode=TwoWay, FallbackValue={StaticResource HeroChipsOpenSections}, TargetNullValue={StaticResource HeroChipsOpenSections}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroChipsOpenSections}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <DockPanel Margin="0,4,0,4">
                                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                                                                       Text="{Binding Value, ElementName=QuickSliderChips1, StringFormat={}{0:0}}" />
                                                                            <TextBlock DockPanel.Dock="Left" Style="{DynamicResource BaseTextBlockStyle}" Width="190" TextWrapping="Wrap" VerticalAlignment="Center"><Run Text="{DynamicResource LOCHNDOptHeroInfoLineMaxWidth}" /></TextBlock>
                                                                            <Slider x:Name="QuickSliderChips1" Minimum="300" Maximum="2000" SmallChange="10" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="True"
                                                                                    VerticalAlignment="Center" Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroInfoLineMaxWidth], Mode=TwoWay, FallbackValue={StaticResource HeroInfoLineMaxWidth}, TargetNullValue={StaticResource HeroInfoLineMaxWidth}}" />
                                                                        </DockPanel>
                                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDQuickChipsShown}" />
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowReleaseDate], Mode=TwoWay, FallbackValue={StaticResource HeroShowReleaseDate}, TargetNullValue={StaticResource HeroShowReleaseDate}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowReleaseDate}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowPlatforms], Mode=TwoWay, FallbackValue={StaticResource HeroShowPlatforms}, TargetNullValue={StaticResource HeroShowPlatforms}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowPlatforms}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowSource], Mode=TwoWay, FallbackValue={StaticResource HeroShowSource}, TargetNullValue={StaticResource HeroShowSource}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowSource}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowGenres], Mode=TwoWay, FallbackValue={StaticResource HeroShowGenres}, TargetNullValue={StaticResource HeroShowGenres}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowGenres}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCategories], Mode=TwoWay, FallbackValue={StaticResource HeroShowCategories}, TargetNullValue={StaticResource HeroShowCategories}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowCategories}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowFeatures], Mode=TwoWay, FallbackValue={StaticResource HeroShowFeatures}, TargetNullValue={StaticResource HeroShowFeatures}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowFeatures}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowTags], Mode=TwoWay, FallbackValue={StaticResource HeroShowTags}, TargetNullValue={StaticResource HeroShowTags}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowTags}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowDevelopers], Mode=TwoWay, FallbackValue={StaticResource HeroShowDevelopers}, TargetNullValue={StaticResource HeroShowDevelopers}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowDevelopers}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCompletionStatus], Mode=TwoWay, FallbackValue={StaticResource HeroShowCompletionStatus}, TargetNullValue={StaticResource HeroShowCompletionStatus}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowCompletionStatus}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCommunityScore], Mode=TwoWay, FallbackValue={StaticResource HeroShowCommunityScore}, TargetNullValue={StaticResource HeroShowCommunityScore}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowCommunityScore}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowHltb], Mode=TwoWay, FallbackValue={StaticResource HeroShowHltb}, TargetNullValue={StaticResource HeroShowHltb}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowHltb}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowAchievements], Mode=TwoWay, FallbackValue={StaticResource HeroShowAchievements}, TargetNullValue={StaticResource HeroShowAchievements}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowAchievements}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowLatestAchievement], Mode=TwoWay, FallbackValue={StaticResource HeroShowLatestAchievement}, TargetNullValue={StaticResource HeroShowLatestAchievement}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowLatestAchievement}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowRareAchievements], Mode=TwoWay, FallbackValue={StaticResource HeroShowRareAchievements}, TargetNullValue={StaticResource HeroShowRareAchievements}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowRareAchievements}" /></TextBlock>
                                                                        </CheckBox>
                                                                        <CheckBox Margin="0,3,0,3" IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowLastSession], Mode=TwoWay, FallbackValue={StaticResource HeroShowLastSession}, TargetNullValue={StaticResource HeroShowLastSession}}">
                                                                            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource LOCHNDOptHeroShowLastSession}" /></TextBlock>
                                                                        </CheckBox>

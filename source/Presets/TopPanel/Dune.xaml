<?xml version="1.0" encoding="utf-8"?>
<!--
    Top panel preset: Dune Rev layout (MIT, hugsyf and sakasakiking), loaded by Theme Options
    instead of the Neon top panel. Logo and search on the left, view buttons centered with the
    filter, extension buttons, notifications and progress on the right, transparent background.
    The theme workshop block between the markers is generated by tools/build_options.py.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <TextBlock Text="&#xe9e9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <TextBlock Text="&#xe1cb;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <TextBlock Text="&#xe12f;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <TextBlock Text="&#xec8f;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectionTemplate">
        <TextBlock Text="&#xe8a9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <TextBlock Text="&#xe145;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <TextBlock Text="&#xf0e2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <TextBlock Text="&#xe292;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <TextBlock Text="&#xe118;" Foreground="OrangeRed" FontWeight="Bold" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <TextBlock Text="&#xe128;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xed59;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xe14b;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <TextBlock Text="&#xe773;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <!-- Dune top panel buttons: soft hover background and an accent line under the active view -->
    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Grid Height="{TemplateBinding Height}" MinWidth="{TemplateBinding Height}">
                        <Border x:Name="HoverBg" Background="White" Opacity="0" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="SelectedBg" Background="White" Opacity="0.08" Visibility="Collapsed" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Viewbox Width="20" Height="20" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Viewbox>
                        <Border x:Name="SelectionIndicator" Width="16" Height="2" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter TargetName="SelectedBg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelHeight], FallbackValue={StaticResource TopPanelHeight}, TargetNullValue={StaticResource TopPanelHeight}}"
                            Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- left: menu, search, back and forward -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Image Source="{ThemeFile 'Images/applogo.png'}" Height="36" RenderOptions.BitmapScalingMode="Fant" Margin="16,0,0,0" />
                                </Border>
                                <SearchBox x:Name="PART_TextMainSearch"
                                           Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}"
                                           Margin="16,6,8,6" VerticalAlignment="Center"
                                           WindowChrome.IsHitTestVisibleInChrome="True"
                                           Width="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelSearchBoxWidthHelium], FallbackValue={StaticResource TopPanelSearchBoxWidthHelium}, TargetNullValue={StaticResource TopPanelSearchBoxWidthHelium}}"
                                           MaxWidth="{Settings DetailsListWitdh}" />
                                <Border Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowNavigationButtons], FallbackValue={StaticResource ShowNavigationButtons}, TargetNullValue={StaticResource ShowNavigationButtons}}" VerticalAlignment="Center"
                                        Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}" Orientation="Horizontal">
                                        <Button Style="{DynamicResource TopPanelNavigateBackButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.BackCommand, FallbackValue={x:Null}}" />
                                        <Button Style="{DynamicResource TopPanelNavigateForwardButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.ForwardCommand, FallbackValue={x:Null}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- center: theme settings, view buttons, filter -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- BEGIN generated workshop: edit tools/options_spec.yaml (workshop), then run tools/build_options.py -->
                                <Grid VerticalAlignment="Center" Margin="{Binding ElementName=PART_ToggleNotifications, Path=Margin}">
                                    <ToggleButton x:Name="ThemeWorkshopToggle" Style="{DynamicResource TopPanelWorkshopToggleStyle}"
                                                  ToolTip="{DynamicResource LOCHNDWorkshopTooltip}" />
                                    <Popup IsOpen="{Binding IsChecked, ElementName=ThemeWorkshopToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                                           PlacementTarget="{Binding ElementName=ThemeWorkshopToggle}" Placement="Bottom" VerticalOffset="6">
                                        <Grid Width="{PluginSettings Plugin=ThemeOptions, Path=Options[SettingsPanelWidth], FallbackValue={StaticResource SettingsPanelWidth}, TargetNullValue={StaticResource SettingsPanelWidth}}" Height="{PluginSettings Plugin=ThemeOptions, Path=Options[SettingsPanelHeight], FallbackValue={StaticResource SettingsPanelHeight}, TargetNullValue={StaticResource SettingsPanelHeight}}">
                                        <Grid.Resources>
                                            <FrameworkContentElement x:Key="HndTopRowReleaseDateItem" Uid="00" ToolTip="{StaticResource HndChipRowReleaseDate}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosReleaseDate], FallbackValue={StaticResource HeroChipPosReleaseDate}, TargetNullValue={StaticResource HeroChipPosReleaseDate}}" />
                                            <FrameworkContentElement x:Key="HndTopRowPlatformsItem" Uid="01" ToolTip="{StaticResource HndChipRowPlatforms}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosPlatforms], FallbackValue={StaticResource HeroChipPosPlatforms}, TargetNullValue={StaticResource HeroChipPosPlatforms}}" />
                                            <FrameworkContentElement x:Key="HndTopRowSourceItem" Uid="02" ToolTip="{StaticResource HndChipRowSource}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosSource], FallbackValue={StaticResource HeroChipPosSource}, TargetNullValue={StaticResource HeroChipPosSource}}" />
                                            <FrameworkContentElement x:Key="HndTopRowGenresItem" Uid="03" ToolTip="{StaticResource HndChipRowGenres}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosGenres], FallbackValue={StaticResource HeroChipPosGenres}, TargetNullValue={StaticResource HeroChipPosGenres}}" />
                                            <FrameworkContentElement x:Key="HndTopRowCategoriesItem" Uid="04" ToolTip="{StaticResource HndChipRowCategories}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosCategories], FallbackValue={StaticResource HeroChipPosCategories}, TargetNullValue={StaticResource HeroChipPosCategories}}" />
                                            <FrameworkContentElement x:Key="HndTopRowFeaturesItem" Uid="05" ToolTip="{StaticResource HndChipRowFeatures}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosFeatures], FallbackValue={StaticResource HeroChipPosFeatures}, TargetNullValue={StaticResource HeroChipPosFeatures}}" />
                                            <FrameworkContentElement x:Key="HndTopRowTagsItem" Uid="06" ToolTip="{StaticResource HndChipRowTags}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosTags], FallbackValue={StaticResource HeroChipPosTags}, TargetNullValue={StaticResource HeroChipPosTags}}" />
                                            <FrameworkContentElement x:Key="HndTopRowDevelopersItem" Uid="07" ToolTip="{StaticResource HndChipRowDevelopers}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosDevelopers], FallbackValue={StaticResource HeroChipPosDevelopers}, TargetNullValue={StaticResource HeroChipPosDevelopers}}" />
                                            <FrameworkContentElement x:Key="HndTopRowCompletionStatusItem" Uid="08" ToolTip="{StaticResource HndChipRowCompletionStatus}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosCompletionStatus], FallbackValue={StaticResource HeroChipPosCompletionStatus}, TargetNullValue={StaticResource HeroChipPosCompletionStatus}}" />
                                            <FrameworkContentElement x:Key="HndTopRowCommunityScoreItem" Uid="09" ToolTip="{StaticResource HndChipRowCommunityScore}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosCommunityScore], FallbackValue={StaticResource HeroChipPosCommunityScore}, TargetNullValue={StaticResource HeroChipPosCommunityScore}}" />
                                            <FrameworkContentElement x:Key="HndTopRowHltbMainItem" Uid="10" ToolTip="{StaticResource HndChipRowHltbMain}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosHltbMain], FallbackValue={StaticResource HeroChipPosHltbMain}, TargetNullValue={StaticResource HeroChipPosHltbMain}}" />
                                            <FrameworkContentElement x:Key="HndTopRowHltbExtraItem" Uid="11" ToolTip="{StaticResource HndChipRowHltbExtra}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosHltbExtra], FallbackValue={StaticResource HeroChipPosHltbExtra}, TargetNullValue={StaticResource HeroChipPosHltbExtra}}" />
                                            <FrameworkContentElement x:Key="HndTopRowHltbCompletionistItem" Uid="12" ToolTip="{StaticResource HndChipRowHltbCompletionist}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosHltbCompletionist], FallbackValue={StaticResource HeroChipPosHltbCompletionist}, TargetNullValue={StaticResource HeroChipPosHltbCompletionist}}" />
                                            <FrameworkContentElement x:Key="HndTopRowAchievementsItem" Uid="13" ToolTip="{StaticResource HndChipRowAchievements}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosAchievements], FallbackValue={StaticResource HeroChipPosAchievements}, TargetNullValue={StaticResource HeroChipPosAchievements}}" />
                                            <FrameworkContentElement x:Key="HndTopRowLatestAchievementItem" Uid="14" ToolTip="{StaticResource HndChipRowLatestAchievement}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosLatestAchievement], FallbackValue={StaticResource HeroChipPosLatestAchievement}, TargetNullValue={StaticResource HeroChipPosLatestAchievement}}" />
                                            <FrameworkContentElement x:Key="HndTopRowRareAchievementsItem" Uid="15" ToolTip="{StaticResource HndChipRowRareAchievements}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosRareAchievements], FallbackValue={StaticResource HeroChipPosRareAchievements}, TargetNullValue={StaticResource HeroChipPosRareAchievements}}" />
                                            <FrameworkContentElement x:Key="HndTopRowLastSessionItem" Uid="16" ToolTip="{StaticResource HndChipRowLastSession}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosLastSession], FallbackValue={StaticResource HeroChipPosLastSession}, TargetNullValue={StaticResource HeroChipPosLastSession}}" />
                                            <FrameworkContentElement x:Key="HndTopRowRecentActivityItem" Uid="17" ToolTip="{StaticResource HndChipRowRecentActivity}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosRecentActivity], FallbackValue={StaticResource HeroChipPosRecentActivity}, TargetNullValue={StaticResource HeroChipPosRecentActivity}}" />
                                            <FrameworkContentElement x:Key="HndTopRowAvgFpsItem" Uid="18" ToolTip="{StaticResource HndChipRowAvgFps}"
                                                                     Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipPosAvgFps], FallbackValue={StaticResource HeroChipPosAvgFps}, TargetNullValue={StaticResource HeroChipPosAvgFps}}" />
                                            <x:Array x:Key="HndTopRowsItems" Type="{x:Type FrameworkContentElement}">
                                                <StaticResource ResourceKey="HndTopRowReleaseDateItem" />
                                                <StaticResource ResourceKey="HndTopRowPlatformsItem" />
                                                <StaticResource ResourceKey="HndTopRowSourceItem" />
                                                <StaticResource ResourceKey="HndTopRowGenresItem" />
                                                <StaticResource ResourceKey="HndTopRowCategoriesItem" />
                                                <StaticResource ResourceKey="HndTopRowFeaturesItem" />
                                                <StaticResource ResourceKey="HndTopRowTagsItem" />
                                                <StaticResource ResourceKey="HndTopRowDevelopersItem" />
                                                <StaticResource ResourceKey="HndTopRowCompletionStatusItem" />
                                                <StaticResource ResourceKey="HndTopRowCommunityScoreItem" />
                                                <StaticResource ResourceKey="HndTopRowHltbMainItem" />
                                                <StaticResource ResourceKey="HndTopRowHltbExtraItem" />
                                                <StaticResource ResourceKey="HndTopRowHltbCompletionistItem" />
                                                <StaticResource ResourceKey="HndTopRowAchievementsItem" />
                                                <StaticResource ResourceKey="HndTopRowLatestAchievementItem" />
                                                <StaticResource ResourceKey="HndTopRowRareAchievementsItem" />
                                                <StaticResource ResourceKey="HndTopRowLastSessionItem" />
                                                <StaticResource ResourceKey="HndTopRowRecentActivityItem" />
                                                <StaticResource ResourceKey="HndTopRowAvgFpsItem" />
                                            </x:Array>
                                            <CollectionViewSource x:Key="HndTopRowsView" Source="{StaticResource HndTopRowsItems}" IsLiveSortingRequested="True">
                                                <CollectionViewSource.SortDescriptions>
                                                    <scm:SortDescription PropertyName="Tag" Direction="Ascending" />
                                                    <scm:SortDescription PropertyName="Uid" Direction="Ascending" />
                                                </CollectionViewSource.SortDescriptions>
                                                <CollectionViewSource.LiveSortingProperties>
                                                    <sys:String>Tag</sys:String>
                                                </CollectionViewSource.LiveSortingProperties>
                                            </CollectionViewSource>
                                            <DataTemplate x:Key="HndTopPreviewBreakReleaseDate">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowReleaseDate], FallbackValue={StaticResource HeroShowReleaseDate}, TargetNullValue={StaticResource HeroShowReleaseDate}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakReleaseDate], FallbackValue={StaticResource HeroChipBreakReleaseDate}, TargetNullValue={StaticResource HeroChipBreakReleaseDate}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakPlatforms">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowPlatforms], FallbackValue={StaticResource HeroShowPlatforms}, TargetNullValue={StaticResource HeroShowPlatforms}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakPlatforms], FallbackValue={StaticResource HeroChipBreakPlatforms}, TargetNullValue={StaticResource HeroChipBreakPlatforms}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakSource">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowSource], FallbackValue={StaticResource HeroShowSource}, TargetNullValue={StaticResource HeroShowSource}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakSource], FallbackValue={StaticResource HeroChipBreakSource}, TargetNullValue={StaticResource HeroChipBreakSource}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakGenres">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowGenres], FallbackValue={StaticResource HeroShowGenres}, TargetNullValue={StaticResource HeroShowGenres}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakGenres], FallbackValue={StaticResource HeroChipBreakGenres}, TargetNullValue={StaticResource HeroChipBreakGenres}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakCategories">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCategories], FallbackValue={StaticResource HeroShowCategories}, TargetNullValue={StaticResource HeroShowCategories}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakCategories], FallbackValue={StaticResource HeroChipBreakCategories}, TargetNullValue={StaticResource HeroChipBreakCategories}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakFeatures">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowFeatures], FallbackValue={StaticResource HeroShowFeatures}, TargetNullValue={StaticResource HeroShowFeatures}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakFeatures], FallbackValue={StaticResource HeroChipBreakFeatures}, TargetNullValue={StaticResource HeroChipBreakFeatures}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakTags">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowTags], FallbackValue={StaticResource HeroShowTags}, TargetNullValue={StaticResource HeroShowTags}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakTags], FallbackValue={StaticResource HeroChipBreakTags}, TargetNullValue={StaticResource HeroChipBreakTags}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakDevelopers">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowDevelopers], FallbackValue={StaticResource HeroShowDevelopers}, TargetNullValue={StaticResource HeroShowDevelopers}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakDevelopers], FallbackValue={StaticResource HeroChipBreakDevelopers}, TargetNullValue={StaticResource HeroChipBreakDevelopers}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakCompletionStatus">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCompletionStatus], FallbackValue={StaticResource HeroShowCompletionStatus}, TargetNullValue={StaticResource HeroShowCompletionStatus}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakCompletionStatus], FallbackValue={StaticResource HeroChipBreakCompletionStatus}, TargetNullValue={StaticResource HeroChipBreakCompletionStatus}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakCommunityScore">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowCommunityScore], FallbackValue={StaticResource HeroShowCommunityScore}, TargetNullValue={StaticResource HeroShowCommunityScore}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakCommunityScore], FallbackValue={StaticResource HeroChipBreakCommunityScore}, TargetNullValue={StaticResource HeroChipBreakCommunityScore}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakHltbMain">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowHltb], FallbackValue={StaticResource HeroShowHltb}, TargetNullValue={StaticResource HeroShowHltb}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakHltbMain], FallbackValue={StaticResource HeroChipBreakHltbMain}, TargetNullValue={StaticResource HeroChipBreakHltbMain}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakHltbExtra">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowHltb], FallbackValue={StaticResource HeroShowHltb}, TargetNullValue={StaticResource HeroShowHltb}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakHltbExtra], FallbackValue={StaticResource HeroChipBreakHltbExtra}, TargetNullValue={StaticResource HeroChipBreakHltbExtra}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakHltbCompletionist">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowHltb], FallbackValue={StaticResource HeroShowHltb}, TargetNullValue={StaticResource HeroShowHltb}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakHltbCompletionist], FallbackValue={StaticResource HeroChipBreakHltbCompletionist}, TargetNullValue={StaticResource HeroChipBreakHltbCompletionist}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakAchievements">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowAchievements], FallbackValue={StaticResource HeroShowAchievements}, TargetNullValue={StaticResource HeroShowAchievements}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakAchievements], FallbackValue={StaticResource HeroChipBreakAchievements}, TargetNullValue={StaticResource HeroChipBreakAchievements}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakLatestAchievement">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowLatestAchievement], FallbackValue={StaticResource HeroShowLatestAchievement}, TargetNullValue={StaticResource HeroShowLatestAchievement}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakLatestAchievement], FallbackValue={StaticResource HeroChipBreakLatestAchievement}, TargetNullValue={StaticResource HeroChipBreakLatestAchievement}}" />
                                                </Grid>
                                            </DataTemplate>
                                            <DataTemplate x:Key="HndTopPreviewBreakRareAchievements">
                                                <Grid Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowRareAchievements], FallbackValue={StaticResource HeroShowRareAchievements}, TargetNullValue={StaticResource HeroShowRareAchievements}}">
                                                    <Grid Height="0" Width="560" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroChipBreakRareAchievements], FallbackValue={StaticResource HeroChipBreakRareAchievements}, TargetNullValue={StaticResource HeroChipBreakRareAchievements}}" />

                                                <TranslateTransform />
                                            </Grid.RenderTransform>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <Button Name="PART_ButtonPlayAction" Style="{DynamicResource HeroPlayButton}" Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" />
                                                <Button Name="PART_ButtonContextAction" Style="{DynamicResource HeroContextButton}" Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" />
                                                <Button Name="PART_ButtonMoreActions" HorizontalAlignment="Right" Content="&#xe228;"
                                                        Tag="{Binding ElementName=PART_ButtonContextAction, Path=Visibility}"
                                                        Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}"
                                                        Style="{DynamicResource HeroMoreActionsButton}" />
                                            </Grid>
                                            <Grid Grid.Column="1" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowEditButton], FallbackValue={StaticResource DetailsViewShowEditButton}, TargetNullValue={StaticResource DetailsViewShowEditButton}}">
                                                <Button x:Name="PART_ButtonEditGame" Margin="8,0,0,0" Focusable="False" Content="&#xe70f;"
                                                        ToolTip="{DynamicResource LOCEditGame}" Style="{DynamicResource HeroIconActionButton}"
                                                        Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" />
                                            </Grid>
                                            <Grid Grid.Column="2" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowFavoriteButton], FallbackValue={StaticResource DetailsViewShowFavoriteButton}, TargetNullValue={StaticResource DetailsViewShowFavoriteButton}}">
                                                <ToggleButton Name="GameFavoriteToggleButton" Margin="8,0,0,0" Focusable="False" ToolTip="{DynamicResource LOCHNDFavoriteButtonTooltip}"
                                                              Style="{DynamicResource HeroFavoriteToggle}"
                                                              Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}"
                                                              Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}"
                                                              IsChecked="{PluginSettings Plugin=ThemeExtras, Path=Game.Favorite, Mode=TwoWay, FallbackValue={StaticResource False}}" />
                                            </Grid>
                                            <!-- ThemeExtras: hide or show the game in the library (eye, crossed out when hidden) -->
                                            <Grid Grid.Column="3" Style="{DynamicResource SectionToggleGrid}" Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowHiddenButton], FallbackValue={StaticResource DetailsViewShowHiddenButton}, TargetNullValue={StaticResource DetailsViewShowHiddenButton}}">
                                                <ToggleButton Name="GameHiddenToggleButton" Margin="8,0,0,0" Focusable="False"
                                                              Style="{DynamicResource HeroFavoriteToggle}" Content="&#xE890;" Tag="&#xED1A;"
                                                              ToolTip="{DynamicResource LOCHNDHiddenButtonTooltip}"
                                                              Height="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}" Width="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], FallbackValue={StaticResource HeroActionButtonHeight}, TargetNullValue={StaticResource HeroActionButtonHeight}}"
                                                              Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}"
                                                              IsChecked="{PluginSettings Plugin=ThemeExtras, Path=Game.Hidden, Mode=TwoWay, FallbackValue={StaticResource False}}" />

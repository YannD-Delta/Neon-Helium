<?xml version="1.0" encoding="utf-8"?>
<!--
    Top panel preset: Dune Rev layout (MIT, hugsyf and sakasakiking), loaded by Theme Options
    instead of the Neon top panel. Logo and search on the left, view buttons centered with the
    filter, extension buttons, notifications and progress on the right, transparent background.
    The theme workshop block between the markers is generated by tools/build_options.py.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <DataTemplate x:Key="TopPanelGeneralViewSettingsTemplate">
        <TextBlock Text="&#xe9e9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <TextBlock Text="&#xe1cb;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <TextBlock Text="&#xe12f;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <TextBlock Text="&#xec8f;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectionTemplate">
        <TextBlock Text="&#xe8a9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <TextBlock Text="&#xe145;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <TextBlock Text="&#xf0e2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <TextBlock Text="&#xe292;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <TextBlock Text="&#xe118;" Foreground="OrangeRed" FontWeight="Bold" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <TextBlock Text="&#xe128;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xed59;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xe14b;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <TextBlock Text="&#xe773;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource FontSizeLarge}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2" />
    </DataTemplate>

    <!-- Dune top panel buttons: soft hover background and an accent line under the active view -->
    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Grid Height="{TemplateBinding Height}" MinWidth="{TemplateBinding Height}">
                        <Border x:Name="HoverBg" Background="White" Opacity="0" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Border x:Name="SelectedBg" Background="White" Opacity="0.08" Visibility="Collapsed" CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <Viewbox Width="20" Height="20" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Viewbox>
                        <Border x:Name="SelectionIndicator" Width="16" Height="2" CornerRadius="1" VerticalAlignment="Bottom"
                                Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter TargetName="SelectedBg" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelHeight], FallbackValue={StaticResource TopPanelHeight}, TargetNullValue={StaticResource TopPanelHeight}}"
                            Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- left: menu, search, back and forward -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border x:Name="PART_ElemMainMenu" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Image Source="{ThemeFile 'Images/applogo.png'}" Height="36" RenderOptions.BitmapScalingMode="Fant" Margin="16,0,0,0" />
                                </Border>
                                <SearchBox x:Name="PART_TextMainSearch"
                                           Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}"
                                           Margin="16,6,8,6" VerticalAlignment="Center"
                                           WindowChrome.IsHitTestVisibleInChrome="True"
                                           Width="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelSearchBoxWidthHelium], FallbackValue={StaticResource TopPanelSearchBoxWidthHelium}, TargetNullValue={StaticResource TopPanelSearchBoxWidthHelium}}"
                                           MaxWidth="{Settings DetailsListWitdh}" />
                                <Border Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowNavigationButtons], FallbackValue={StaticResource ShowNavigationButtons}, TargetNullValue={StaticResource ShowNavigationButtons}}" VerticalAlignment="Center"
                                        Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}" Orientation="Horizontal">
                                        <Button Style="{DynamicResource TopPanelNavigateBackButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.BackCommand, FallbackValue={x:Null}}" />
                                        <Button Style="{DynamicResource TopPanelNavigateForwardButtonStyle}" Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.ForwardCommand, FallbackValue={x:Null}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- center: theme settings, view buttons, filter -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- BEGIN generated workshop: edit tools/options_spec.yaml (workshop), then run tools/build_options.py -->
                                <Grid VerticalAlignment="Center" Margin="{Binding ElementName=PART_ToggleNotifications, Path=Margin}">
                                    <ToggleButton x:Name="ThemeWorkshopToggle" Style="{DynamicResource TopPanelWorkshopToggleStyle}"
                                                  ToolTip="{DynamicResource LOCHNDWorkshopTooltip}" />
                                    <Popup IsOpen="{Binding IsChecked, ElementName=ThemeWorkshopToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                                           PlacementTarget="{Binding ElementName=ThemeWorkshopToggle}" Placement="Bottom" VerticalOffset="6">
                                        <Border Style="{DynamicResource QuickSettingsPanel}" Width="460" MaxWidth="460">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Style="{DynamicResource QuickSettingsTitle}" Text="{DynamicResource LOCHNDWorkshopTitle}" />
                                                    <TextBlock Style="{DynamicResource QuickSettingsHint}" Text="{DynamicResource LOCHNDQuickNeedsThemeOptions}"
                                                               Visibility="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" />
                                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDWorkshopIntro}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextBrushDarker}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,4" />
                                                    <StackPanel IsEnabled="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed}">
                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopArtworkheader}" />
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeroMinHeight}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeroMinHeight}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopHeroMinHeightSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopHeroMinHeightSlider" Minimum="300" Maximum="900" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroMinHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeroMinHeight}}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeroActionButtonWidth}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeroActionButtonWidth}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopHeroActionButtonWidthSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopHeroActionButtonWidthSlider" Minimum="200" Maximum="600" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonWidth], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeroActionButtonWidth}}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeroActionButtonHeight}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeroActionButtonHeight}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopHeroActionButtonHeightSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopHeroActionButtonHeightSlider" Minimum="28" Maximum="72" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroActionButtonHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeroActionButtonHeight}}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipGameLogoMaxWidth}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptGameLogoMaxWidth}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopGameLogoMaxWidthSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopGameLogoMaxWidthSlider" Minimum="100" Maximum="2000" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[GameLogoMaxWidth], Mode=TwoWay, Delay=150, FallbackValue={StaticResource GameLogoMaxWidth}}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipGameLogoMaxHeight}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptGameLogoMaxHeight}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopGameLogoMaxHeightSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopGameLogoMaxHeightSlider" Minimum="50" Maximum="1000" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[GameLogoMaxHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource GameLogoMaxHeight}}" />
                                                        </DockPanel>
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowEditButton}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowEditButton}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowEditButton], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowEditButton}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowFavoriteButton}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowFavoriteButton}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowFavoriteButton], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowFavoriteButton}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowHiddenButton}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowHiddenButton}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowHiddenButton], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowHiddenButton}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHeroShowSteamShortcuts}" ToolTip="{DynamicResource LOCHNDTipHeroShowSteamShortcuts}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowSteamShortcuts], Mode=TwoWay, FallbackValue={StaticResource HeroShowSteamShortcuts}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHeroShowUpdateStatus}" ToolTip="{DynamicResource LOCHNDTipHeroShowUpdateStatus}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowUpdateStatus], Mode=TwoWay, FallbackValue={StaticResource HeroShowUpdateStatus}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewAllowUseOfLogos}" ToolTip="{DynamicResource LOCHNDTipDetailsViewAllowUseOfLogos}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewAllowUseOfLogos], Mode=TwoWay, FallbackValue={StaticResource DetailsViewAllowUseOfLogos}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewDisplayGameNameIfLogoVisible}" ToolTip="{DynamicResource LOCHNDTipDetailsViewDisplayGameNameIfLogoVisible}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewDisplayGameNameIfLogoVisible], Mode=TwoWay, FallbackValue={StaticResource DetailsViewDisplayGameNameIfLogoVisible}}" />
                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopChips}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHeroShowInfoLine}" ToolTip="{DynamicResource LOCHNDTipHeroShowInfoLine}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroShowInfoLine], Mode=TwoWay, FallbackValue={StaticResource HeroShowInfoLine}}" />
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeroInfoLineMaxWidth}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeroInfoLineMaxWidth}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopHeroInfoLineMaxWidthSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopHeroInfoLineMaxWidthSlider" Minimum="300" Maximum="2000" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeroInfoLineMaxWidth], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeroInfoLineMaxWidth}}" />
                                                        </DockPanel>
                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopHeaderbar}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowHeaderBar}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowHeaderBar}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowHeaderBar], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowHeaderBar}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowLastPlayed}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowLastPlayed}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowLastPlayed], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowLastPlayed}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowPlayTime}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowPlayTime}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowPlayTime], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowPlayTime}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowCompletionStatus}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowCompletionStatus}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowCompletionStatus], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowCompletionStatus}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowAchievementsSummary}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowAchievementsSummary}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowAchievementsSummary], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowAchievementsSummary}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHltbShowInHeaderBar}" ToolTip="{DynamicResource LOCHNDTipHltbShowInHeaderBar}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HltbShowInHeaderBar], Mode=TwoWay, FallbackValue={StaticResource HltbShowInHeaderBar}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowUserRating}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowUserRating}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowUserRating], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowUserRating}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowInfoButton}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowInfoButton}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowInfoButton], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowInfoButton}}" />
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipHeaderButtonSize}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptHeaderButtonSize}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopHeaderButtonSizeSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopHeaderButtonSizeSlider" Minimum="20" Maximum="56" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[HeaderButtonSize], Mode=TwoWay, Delay=150, FallbackValue={StaticResource HeaderButtonSize}}" />
                                                        </DockPanel>
                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopCover}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptHltbShowOnCover}" ToolTip="{DynamicResource LOCHNDTipHltbShowOnCover}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[HltbShowOnCover], Mode=TwoWay, FallbackValue={StaticResource HltbShowOnCover}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptAchievementsShowOnCover}" ToolTip="{DynamicResource LOCHNDTipAchievementsShowOnCover}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[AchievementsShowOnCover], Mode=TwoWay, FallbackValue={StaticResource AchievementsShowOnCover}}" />
                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopGamelistandcovers}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptLibraryListShowHltb}" ToolTip="{DynamicResource LOCHNDTipLibraryListShowHltb}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[LibraryListShowHltb], Mode=TwoWay, FallbackValue={StaticResource LibraryListShowHltb}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptLibraryListShowAchievements}" ToolTip="{DynamicResource LOCHNDTipLibraryListShowAchievements}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[LibraryListShowAchievements], Mode=TwoWay, FallbackValue={StaticResource LibraryListShowAchievements}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptGridCoverShowHltb}" ToolTip="{DynamicResource LOCHNDTipGridCoverShowHltb}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[GridCoverShowHltb], Mode=TwoWay, FallbackValue={StaticResource GridCoverShowHltb}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptGridCoverShowAchievements}" ToolTip="{DynamicResource LOCHNDTipGridCoverShowAchievements}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[GridCoverShowAchievements], Mode=TwoWay, FallbackValue={StaticResource GridCoverShowAchievements}}" />
                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopSections}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDemoteSectionsShownElsewhere}" ToolTip="{DynamicResource LOCHNDTipDemoteSectionsShownElsewhere}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DemoteSectionsShownElsewhere], Mode=TwoWay, FallbackValue={StaticResource DemoteSectionsShownElsewhere}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewUseMetadataUtilities}" ToolTip="{DynamicResource LOCHNDTipDetailsViewUseMetadataUtilities}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewUseMetadataUtilities], Mode=TwoWay, FallbackValue={StaticResource DetailsViewUseMetadataUtilities}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptDetailsViewShowInfoPanelDefault}" ToolTip="{DynamicResource LOCHNDTipDetailsViewShowInfoPanelDefault}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewShowInfoPanelDefault], Mode=TwoWay, FallbackValue={StaticResource DetailsViewShowInfoPanelDefault}}" />
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipSectionHeaderMinHeight}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptSectionHeaderMinHeight}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopSectionHeaderMinHeightSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopSectionHeaderMinHeightSlider" Minimum="24" Maximum="64" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[SectionHeaderMinHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource SectionHeaderMinHeight}}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipDetailsViewDescriptionWidth}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptDetailsViewDescriptionWidth}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopDetailsViewDescriptionWidthSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopDetailsViewDescriptionWidthSlider" Minimum="150" Maximum="2400" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewDescriptionWidth], Mode=TwoWay, Delay=150, FallbackValue={StaticResource DetailsViewDescriptionWidth}}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipDetailsViewDescriptionMaxHeight}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptDetailsViewDescriptionMaxHeight}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopDetailsViewDescriptionMaxHeightSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopDetailsViewDescriptionMaxHeightSlider" Minimum="110" Maximum="2000" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[DetailsViewDescriptionMaxHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource DetailsViewDescriptionMaxHeight}}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipAchievementsDataGridMaxHeight}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptAchievementsDataGridMaxHeight}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopAchievementsDataGridMaxHeightSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopAchievementsDataGridMaxHeightSlider" Minimum="100" Maximum="1200" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[AchievementsDataGridMaxHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource AchievementsDataGridMaxHeight}}" />
                                                        </DockPanel>
                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopLinks}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptLinksShowNames}" ToolTip="{DynamicResource LOCHNDTipLinksShowNames}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[LinksShowNames], Mode=TwoWay, FallbackValue={StaticResource LinksShowNames}}" />
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipLinkIconSize}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptLinkIconSize}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopLinkIconSizeSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopLinkIconSizeSlider" Minimum="12" Maximum="48" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[LinkIconSize], Mode=TwoWay, Delay=150, FallbackValue={StaticResource LinkIconSize}}" />
                                                        </DockPanel>
                                                        <TextBlock Style="{DynamicResource QuickSettingsHeading}" Text="{DynamicResource LOCHNDWorkshopToppanel}" />
                                                        <DockPanel Margin="0,4,0,4" Background="Transparent" ToolTip="{DynamicResource LOCHNDTipTopPanelHeight}">
                                                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource BaseTextBlockStyle}" Text="{DynamicResource LOCHNDOptTopPanelHeight}" Margin="0,0,0,2" />
                                                            <TextBlock DockPanel.Dock="Right" Style="{DynamicResource BaseTextBlockStyle}" Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                                       Text="{Binding Value, ElementName=WorkshopTopPanelHeightSlider, StringFormat={}{0:0}}" />
                                                            <Slider x:Name="WorkshopTopPanelHeightSlider" Minimum="36" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                                    VerticalAlignment="Center"
                                                                    Value="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelHeight], Mode=TwoWay, Delay=150, FallbackValue={StaticResource TopPanelHeight}}" />
                                                        </DockPanel>
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptShowNavigationButtons}" ToolTip="{DynamicResource LOCHNDTipShowNavigationButtons}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[ShowNavigationButtons], Mode=TwoWay, FallbackValue={StaticResource ShowNavigationButtons}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptTopPanelShowThemeSettingsButtons}" ToolTip="{DynamicResource LOCHNDTipTopPanelShowThemeSettingsButtons}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelShowThemeSettingsButtons], Mode=TwoWay, FallbackValue={StaticResource TopPanelShowThemeSettingsButtons}}" />
                                                        <CheckBox Margin="0,3,0,3" Content="{DynamicResource LOCHNDOptTopPanelShowCollectorLevel}" ToolTip="{DynamicResource LOCHNDTipTopPanelShowCollectorLevel}"
                                                                  IsChecked="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelShowCollectorLevel], Mode=TwoWay, FallbackValue={StaticResource TopPanelShowCollectorLevel}}" />
                                                    </StackPanel>
                                                    <WrapPanel Margin="0,12,0,0" Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}">
                                                        <Button Margin="0,4,8,0" Padding="10,5,10,5" Content="{DynamicResource LOCHNDQuickThemeSettings}"
                                                                Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.OpenPluginSettingsCommand, FallbackValue={x:Null}}"
                                                                CommandParameter="904cbf3b-573f-48f8-9642-0a09d05c64ef" />
                                                        <Button Margin="0,4,8,0" Padding="10,5,10,5" Content="{DynamicResource LOCHNDWorkshopColors}"
                                                                Visibility="{PluginStatus Plugin=playnite-thememodifier-plugin, Status=Installed}"
                                                                Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.OpenPluginSettingsCommand, FallbackValue={x:Null}}"
                                                                CommandParameter="ec2f4013-17e6-428a-b8a9-5e34a3b80009" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <!-- END generated workshop -->
                                <Border Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelShowThemeSettingsButtons], FallbackValue={StaticResource TopPanelShowThemeSettingsButtons}, TargetNullValue={StaticResource TopPanelShowThemeSettingsButtons}}" VerticalAlignment="Center"
                                        Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}" Orientation="Horizontal">
                                        <Button Style="{DynamicResource TopPanelThemeOptionsButtonStyle}"
                                                ToolTip="{DynamicResource LOCHNDThemeOptionsButton}"
                                                Visibility="{PluginStatus Plugin=ThemeOptions_904cbf3b-573f-48f8-9642-0a09d05c64ef, Status=Installed}"
                                                Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.OpenPluginSettingsCommand, FallbackValue={x:Null}}"
                                                CommandParameter="904cbf3b-573f-48f8-9642-0a09d05c64ef" />
                                        <Button Style="{DynamicResource TopPanelThemeColorsButtonStyle}"
                                                ToolTip="{DynamicResource LOCHNDThemeColorsButton}"
                                                Visibility="{PluginStatus Plugin=playnite-thememodifier-plugin, Status=Installed}"
                                                Command="{PluginSettings Plugin=ThemeExtras, Path=Commands.OpenPluginSettingsCommand, FallbackValue={x:Null}}"
                                                CommandParameter="ec2f4013-17e6-428a-b8a9-5e34a3b80009" />
                                    </StackPanel>
                                </Border>
                                <!-- PlayniteAchievements: library collection level, opens the achievements overview -->
                                <Grid Style="{DynamicResource SectionToggleGrid}" VerticalAlignment="Center"
                                      Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[TopPanelShowCollectorLevel], FallbackValue={StaticResource TopPanelShowCollectorLevel}, TargetNullValue={StaticResource TopPanelShowCollectorLevel}}">
                                    <Button Style="{DynamicResource TopPanelCollectorButtonStyle}"
                                            Tag="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevel, FallbackValue=0}"
                                            ToolTip="{DynamicResource LOCHNDCollectorTooltip}"
                                            Command="{PluginSettings Plugin=PlayniteAchievements, Path=OpenAchievementWindow, FallbackValue={x:Null}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{DynamicResource FontIcoFont}" Text="&#xEDD7;" FontSize="15" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource GlyphBrush}" />
                                                <TextBlock Text="{DynamicResource LOCHNDCollectorLevel}" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevel, FallbackValue=0}" Margin="3,0,0,0"
                                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ProgressBar Height="2" Margin="0,3,0,0" Minimum="0" Maximum="100" IsHitTestVisible="False"
                                                         Value="{PluginSettings Plugin=PlayniteAchievements, Path=CollectorLevelProgress, FallbackValue=0}"
                                                         Foreground="{DynamicResource GlyphBrush}" Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="4,6,0,6" />
                                <Border Width="1" Height="20" Margin="8,0,0,0" Background="{DynamicResource PanelSeparatorBrush}" VerticalAlignment="Center" />
                                <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}" Margin="8,0,0,0"
                                          Style="{DynamicResource TopPanelFilterToggle}" />
                            </StackPanel>

                            <!-- right: extension buttons, notifications, progress -->
                            <DockPanel Grid.Column="2" Margin="0,0,120,0">
                                <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="8,6,8,6"
                                            DockPanel.Dock="{Settings PluginTopPanelAlignment}" />
                                <CheckBox x:Name="PART_ToggleNotifications" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Style="{DynamicResource TopPanelNotificationsToggle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                                    <Grid MaxWidth="260">
                                        <ProgressBar Name="PART_ProgressGlobal" Background="{DynamicResource TopPanelSearchBoxBackgroundBrush}" />
                                        <TextBlock Name="PART_TextProgressText" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Style="{DynamicResource BaseTextBlockStyle}" Margin="8,2,8,2" />
                                    </Grid>
                                    <Button Name="PART_ButtonProgressCancel" VerticalAlignment="Center" Content="{DynamicResource LOCCancelLabel}"
                                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="4,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
